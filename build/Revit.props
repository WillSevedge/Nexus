<Project>
  <!--
    Imported at the top of the Revit agent project (before TargetFramework is set).
    Revit's .NET runtime is not fixed per year: Revit 2026 shipped on .NET 8, but
    later 2026 updates (API 26.5+) are built on .NET 10. When Revit is installed,
    read the target framework the installed RevitAPI.dll was built for and compile
    against the same one; otherwise use HostTargetFramework from HostVersions.props.
    Override with /p:RevitTargetFramework=net10.0-windows if detection is wrong.
  -->
  <PropertyGroup Condition="'$(RevitTargetFramework)' == '' and Exists('$(RevitInstallDir)RevitAPI.dll')">
    <_AecHubRevitApiTfm>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RevitInstallDir)RevitAPI.dll')), 'NETCoreApp,Version=v\d+\.\d+').Value)</_AecHubRevitApiTfm>
    <RevitTargetFramework Condition="'$(_AecHubRevitApiTfm)' != ''">net$(_AecHubRevitApiTfm.Substring(20))-windows</RevitTargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <RevitTargetFramework Condition="'$(RevitTargetFramework)' == ''">$(HostTargetFramework)</RevitTargetFramework>
  </PropertyGroup>
</Project>
