<Window x:Class="Nexus.Hub.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="Nexus - Go to" Width="680" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
  <StackPanel Margin="12">
    <Grid>
      <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="38,9,10,9"
               PreviewKeyDown="OnQueryKeyDown" />
      <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="13,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock Text="Type a sheet number, an action or a view…" Margin="39,0,0,0" VerticalAlignment="Center" FontSize="16"
                 IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <ListBox x:Name="List" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="420" Margin="0,8,0,0"
             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseLeftButtonUp="OnListClick">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:PaletteItem}">
          <DockPanel Margin="4,5">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                       Width="28" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Text="{Binding Footer}" FontSize="12" Margin="4,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
  </StackPanel>
</Window>
