<Application x:Class="Nexus.Hub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup"
             Exit="OnExit"
             DispatcherUnhandledException="OnUnhandledException">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Design tokens and colours (the palette is swapped for dark mode by AppTheme). -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Palette.Light.xaml" />
        <ResourceDictionary Source="Themes/Tokens.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Header" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
