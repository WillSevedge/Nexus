<Window x:Class="Nexus.Hub.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus - Rename and renumber" Height="680" Width="1080" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/Nexus.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="24,18,24,20">
    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Rename &amp; renumber" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Scope}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
    </StackPanel>

    <!-- Footer -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{Binding StageText}" Command="{Binding StageCommand}" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Padding="16,6" />
        <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" Padding="16,6" />
      </StackPanel>
      <TextBlock Text="Changes are staged like your own edits. Nothing changes in the files until Review &amp; apply."
                 VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: what and how -->
      <StackPanel Grid.Column="0">
        <TextBlock Text="Change" Style="{StaticResource Label}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}" HorizontalAlignment="Stretch" />

        <TabControl SelectedIndex="{Binding ModeIndex}" Margin="0,16,0,0" Background="Transparent" BorderThickness="0">
          <TabItem Header="Renumber">
            <StackPanel Margin="2,4,2,0">
              <TextBlock Text="Pattern" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged, Delay=200}" FontFamily="Consolas" FontSize="14" />
              <TextBlock Style="{StaticResource Hint}" Text="# is the counter, padded to as many digits as #s: A1## gives A101, A102… No # adds the number at the end." />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Start at" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Step" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Text="Items are numbered in the order shown in the table: sort the table first to change the order." />
            </StackPanel>
          </TabItem>
          <TabItem Header="Replace">
            <StackPanel Margin="2,4,2,0">
              <TextBlock Text="Find" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Find, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
              <TextBlock Text="Replace with" Style="{StaticResource Label}" />
              <TextBox Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
              <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" Margin="0,12,0,0" />
              <CheckBox Content="Match the whole value" IsChecked="{Binding WholeValue}" Margin="0,4,0,0" />
              <TextBlock Style="{StaticResource Hint}" Text="* matches any text and ? one character, e.g. *FLOOR* or A-1??." />
            </StackPanel>
          </TabItem>
          <TabItem Header="Capitals">
            <StackPanel Margin="2,12,2,0">
              <RadioButton Content="UPPER CASE" IsChecked="{Binding Upper}" Margin="0,0,0,6" />
              <RadioButton Content="lower case" IsChecked="{Binding Lower}" Margin="0,0,0,6" />
              <RadioButton Content="Title Case" IsChecked="{Binding Title}" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Add">
            <StackPanel Margin="2,4,2,0">
              <TextBlock Text="Before" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
              <TextBlock Text="After" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Remove">
            <StackPanel Margin="2,4,2,0">
              <TextBlock Text="From the start" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
              <TextBlock Text="From the end" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
              <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" Margin="0,12,0,0" />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>

      <!-- Right: preview -->
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Select all" Command="{Binding SelectAllCommand}" Padding="10,3" />
            <Button Content="Select none" Command="{Binding SelectNoneCommand}" Padding="10,3" Margin="6,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" ClipToBounds="True">
          <DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent"
                    RowBackground="Transparent" SelectionMode="Single" EnableRowVirtualization="True"
                    HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}"
                              HorizontalAlignment="Center" MinWidth="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="File" Binding="{Binding Where}" IsReadOnly="True" Width="130" />
              <DataGridTextColumn Header="Item" Binding="{Binding Item}" IsReadOnly="True" Width="1.2*" />
              <DataGridTemplateColumn Header="Now" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Old}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChange}" Value="True">
                              <Setter Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="New" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Change">
                              <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Duplicate">
                              <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding New}" FontWeight="SemiBold" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="1.3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}">
                      <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="{Binding Message, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
