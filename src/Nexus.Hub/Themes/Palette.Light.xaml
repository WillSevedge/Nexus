<!-- Nexus colours, Light theme. AppTheme swaps this dictionary with the other palette; keys must match. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Nexus.Background" Color="#F8FAFC" />
  <SolidColorBrush x:Key="Nexus.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Nexus.SurfaceAlt" Color="#F1F5F9" />
  <SolidColorBrush x:Key="Nexus.Text" Color="#1E293B" />
  <SolidColorBrush x:Key="Nexus.TextSecondary" Color="#64748B" />
  <SolidColorBrush x:Key="Nexus.TextTertiary" Color="#94A3B8" />
  <SolidColorBrush x:Key="Nexus.Border" Color="#E2E8F0" />
  <SolidColorBrush x:Key="Nexus.BorderStrong" Color="#CBD5E1" />
  <SolidColorBrush x:Key="Nexus.Accent" Color="#2563EB" />
  <SolidColorBrush x:Key="Nexus.AccentHover" Color="#1D4ED8" />
  <SolidColorBrush x:Key="Nexus.AccentSubtle" Color="#E8EFFD" />
  <SolidColorBrush x:Key="Nexus.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Nexus.Hover" Color="#F1F5F9" />
  <SolidColorBrush x:Key="Nexus.Pressed" Color="#E2E8F0" />
  <SolidColorBrush x:Key="Nexus.Rail" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Nexus.Success" Color="#15803D" />
  <SolidColorBrush x:Key="Nexus.SuccessSubtle" Color="#DCFCE7" />
  <SolidColorBrush x:Key="Nexus.Warning" Color="#B45309" />
  <SolidColorBrush x:Key="Nexus.WarningSubtle" Color="#FEF3C7" />
  <SolidColorBrush x:Key="Nexus.Danger" Color="#DC2626" />
  <SolidColorBrush x:Key="Nexus.DangerSubtle" Color="#FEE2E2" />
  <SolidColorBrush x:Key="Nexus.Info" Color="#2563EB" />
  <SolidColorBrush x:Key="Nexus.InfoSubtle" Color="#DBEAFE" />
  <SolidColorBrush x:Key="Nexus.GridHeader" Color="#F8FAFC" />
  <SolidColorBrush x:Key="Nexus.GridRowHover" Color="#F5F8FC" />
  <SolidColorBrush x:Key="Nexus.GridSelection" Color="#DBE7FD" />
  <Color x:Key="Nexus.ShadowColor">#0F172A</Color>
</ResourceDictionary>
