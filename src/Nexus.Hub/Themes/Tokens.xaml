<!--
  Nexus design tokens: type scale, spacing, corner radii and the shared control styles of the hub.
  Colours come from Palette.Light.xaml / Palette.Dark.xaml (swapped by AppTheme), so everything here uses
  DynamicResource for brushes. Styles here must not be BasedOn the Windows 11 (Fluent) styles: this dictionary
  loads before the theme is applied. Window-level styles can derive from them.

  Spacing scale: 4 / 8 / 12 / 16 / 24 / 32.   Radii: 4 (small) / 6 (controls) / 10 (cards, panels).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <!-- Icons: Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10. -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- ===================== Type ===================== -->
  <FontFamily x:Key="Nexus.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
  <sys:Double x:Key="Nexus.FontSize.Heading">22</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Section">16</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Body">13</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Small">12</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Caption">11</sys:Double>

  <!-- ===================== Shape ===================== -->
  <CornerRadius x:Key="Nexus.Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Nexus.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Nexus.Radius.Panel">10</CornerRadius>

  <sys:Double x:Key="Nexus.Rail.Collapsed">60</sys:Double>
  <sys:Double x:Key="Nexus.Rail.Expanded">228</sys:Double>
  <sys:Double x:Key="Nexus.Inspector.Width">340</sys:Double>

  <!-- ===================== Text ===================== -->
  <Style x:Key="Nexus.Text.Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Nexus.Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Section}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
  </Style>
  <Style x:Key="Nexus.Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Nexus.Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Nexus.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
  </Style>
  <!-- Small caps label above a group ("SOURCES", "VIEWS"). -->
  <Style x:Key="Nexus.Text.Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextTertiary}" />
    <Setter Property="Margin" Value="12,16,12,6" />
  </Style>

  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===================== Surfaces ===================== -->
  <Style x:Key="Nexus.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nexus.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Nexus.Radius.Panel}" />
  </Style>

  <!-- Small rounded label: "Revit 2026", "3 selected", "Busy". -->
  <Style x:Key="Nexus.Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nexus.SurfaceAlt}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Nexus.Divider" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Fill" Value="{DynamicResource Nexus.Border}" />
  </Style>

  <!-- ===================== Buttons ===================== -->
  <!-- Flat icon + text button for command bars. -->
  <Style x:Key="Nexus.CommandButton" TargetType="Button">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Nexus.CommandToggle" TargetType="ToggleButton">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Square icon-only button (close, pin, overflow). -->
  <Style x:Key="Nexus.IconButton" TargetType="Button" BasedOn="{StaticResource Nexus.CommandButton}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Square icon-only toggle (density, inspector, health). -->
  <Style x:Key="Nexus.IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource Nexus.CommandToggle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Filled accent button: the one main action of a panel. -->
  <Style x:Key="Nexus.PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nexus.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.OnAccent}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Outlined button: secondary actions next to a primary one. -->
  <Style x:Key="Nexus.SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nexus.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Border}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Navigation rail ===================== -->
  <!-- A workspace in the rail: icon, label when expanded, accent bar when selected. -->
  <Style x:Key="Nexus.RailItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Nexus.Radius.Control}" BorderThickness="1" BorderBrush="Transparent">
            <Grid>
              <Border x:Name="Pill" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-1,0,0,0"
                      Background="{DynamicResource Nexus.Accent}" Visibility="Collapsed" />
              <ContentPresenter Margin="12,0,8,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A tool in the rail (opens a window): same look, no selected state. -->
  <Style x:Key="Nexus.RailButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Nexus.Radius.Control}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter Margin="12,0,8,0" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A view in the Sheets workspace's explorer list (Sheets, Revisions…). -->
  <Style x:Key="Nexus.NavItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bg" CornerRadius="{StaticResource Nexus.Radius.Control}" Background="Transparent" Padding="8,6"
                  BorderThickness="1" BorderBrush="Transparent">
            <Grid>
              <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-7,0,0,0"
                      Background="{DynamicResource Nexus.Accent}" Visibility="Collapsed" />
              <ContentPresenter Margin="4,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
