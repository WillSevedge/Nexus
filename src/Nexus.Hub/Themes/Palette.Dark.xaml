<!-- Nexus colours, Dark theme. AppTheme swaps this dictionary with the other palette; keys must match. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Nexus.Background" Color="#111827" />
  <SolidColorBrush x:Key="Nexus.Surface" Color="#1F2937" />
  <SolidColorBrush x:Key="Nexus.SurfaceAlt" Color="#273449" />
  <SolidColorBrush x:Key="Nexus.Text" Color="#F3F4F6" />
  <SolidColorBrush x:Key="Nexus.TextSecondary" Color="#94A3B8" />
  <SolidColorBrush x:Key="Nexus.TextTertiary" Color="#6B7280" />
  <SolidColorBrush x:Key="Nexus.Border" Color="#374151" />
  <SolidColorBrush x:Key="Nexus.BorderStrong" Color="#4B5563" />
  <SolidColorBrush x:Key="Nexus.Accent" Color="#60A5FA" />
  <SolidColorBrush x:Key="Nexus.AccentHover" Color="#93C5FD" />
  <SolidColorBrush x:Key="Nexus.AccentSubtle" Color="#1E3A5F" />
  <SolidColorBrush x:Key="Nexus.OnAccent" Color="#0B1220" />
  <SolidColorBrush x:Key="Nexus.Hover" Color="#273449" />
  <SolidColorBrush x:Key="Nexus.Pressed" Color="#334155" />
  <SolidColorBrush x:Key="Nexus.Rail" Color="#0F1623" />
  <SolidColorBrush x:Key="Nexus.Success" Color="#4ADE80" />
  <SolidColorBrush x:Key="Nexus.SuccessSubtle" Color="#14321F" />
  <SolidColorBrush x:Key="Nexus.Warning" Color="#FBBF24" />
  <SolidColorBrush x:Key="Nexus.WarningSubtle" Color="#3A2E12" />
  <SolidColorBrush x:Key="Nexus.Danger" Color="#F87171" />
  <SolidColorBrush x:Key="Nexus.DangerSubtle" Color="#3B1D1D" />
  <SolidColorBrush x:Key="Nexus.Info" Color="#60A5FA" />
  <SolidColorBrush x:Key="Nexus.InfoSubtle" Color="#1E3A5F" />
  <SolidColorBrush x:Key="Nexus.GridHeader" Color="#1A2333" />
  <SolidColorBrush x:Key="Nexus.GridRowHover" Color="#243041" />
  <SolidColorBrush x:Key="Nexus.GridSelection" Color="#1E3A5F" />
  <Color x:Key="Nexus.ShadowColor">#000000</Color>
</ResourceDictionary>
