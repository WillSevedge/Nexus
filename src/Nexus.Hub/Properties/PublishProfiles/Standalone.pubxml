<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained Nexus.exe: no .NET install or Visual Studio needed on the PC that runs it. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Only Nexus.exe in the output: no .pdb files from the referenced libraries. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\Nexus\</PublishDir>
  </PropertyGroup>
</Project>
