<Window x:Class="Nexus.Hub.ApplyChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus - Apply changes" Height="520" Width="1100" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Apply to the model" Command="{Binding ApplyCommand}" FontWeight="SemiBold" IsDefault="True" />
      <Button Content="{Binding CloseLabel}" IsCancel="True" Click="OnClose" />
    </StackPanel>

    <DataGrid ItemsSource="{Binding Changes}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Vertical" EnableRowVirtualization="True">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Applied">
              <Setter Property="Background" Value="#E3F4E6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Skipped">
              <Setter Property="Background" Value="#FFF3D6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failed">
              <Setter Property="Background" Value="#FBE3E1" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Document" Binding="{Binding Document}" Width="140" />
        <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="180" />
        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="200" />
        <DataGridTextColumn Header="Old value" Binding="{Binding OldValue}" Width="140" />
        <DataGridTextColumn Header="New value" Binding="{Binding NewValue}" Width="140" FontWeight="SemiBold" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
        <DataGridTextColumn Header="Now in model" Binding="{Binding Result}" Width="120" />
        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
