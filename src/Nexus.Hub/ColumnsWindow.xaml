<Window x:Class="Nexus.Hub.ColumnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="Nexus - Columns" Height="640" Width="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="Assets/Nexus.ico" Background="#F5F6F8">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" Text="Pick the columns to show. Every property stays available in the details pane and in exports."
               TextWrapping="Wrap" Foreground="#444" Margin="0,0,0,8" />
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="None" Click="OnNone" Margin="6,0,0,0" />
      <Button DockPanel.Dock="Right" Content="All shown" Click="OnAll" Margin="6,0,0,0" />
      <TextBox x:Name="FilterBox" TextChanged="OnFilter" Padding="4,3" ToolTip="Filter by group or column name" />
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="OK" Click="OnOk" IsDefault="True" FontWeight="SemiBold" />
      <Button Content="Cancel" IsCancel="True" />
    </StackPanel>
    <TreeView x:Name="Tree" Background="White">
      <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:ColumnGroupNode}" ItemsSource="{Binding Columns}">
          <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Title}" FontWeight="SemiBold" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:ColumnNode}">
          <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" />
        </DataTemplate>
      </TreeView.Resources>
    </TreeView>
  </DockPanel>
</Window>
