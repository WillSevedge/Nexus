<Window x:Class="Nexus.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="Nexus" Height="900" Width="1520" WindowStartupLocation="CenterScreen"
        Icon="Assets/Nexus.ico" Background="#F5F6F8">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <CollectionViewSource x:Key="DatasetsView" Source="{Binding Datasets}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Category" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <SolidColorBrush x:Key="Accent" Color="#1F4E8C" />
    <SolidColorBrush x:Key="Line" Color="#E1E4E8" />

    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#6A737D" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#B0700A" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" VerticalAlignment="Center" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Top bar: what to show, search, actions -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Image Source="Assets/Nexus.ico" Width="22" Height="22" VerticalAlignment="Center" />
          <TextBlock Text="Nexus" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,22,0" />
          <TextBlock Text="Show" VerticalAlignment="Center" Foreground="#555" Margin="0,0,6,0" />
          <ComboBox Width="250" ItemsSource="{Binding Source={StaticResource DatasetsView}}" SelectedItem="{Binding SelectedDataset}"
                    VerticalContentAlignment="Center" Padding="6,4" ToolTip="{Binding SelectedDataset.Description}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DatasetNode}">
                <TextBlock Text="{Binding Title}" ToolTip="{Binding Description}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="4,6,0,2" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ComboBox.GroupStyle>
          </ComboBox>
          <ToggleButton x:Name="OptionsToggle" Content="Options" Margin="6,0,0,0" Padding="10,4"
                        Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}" />
          <Popup IsOpen="{Binding IsChecked, ElementName=OptionsToggle}" PlacementTarget="{Binding ElementName=OptionsToggle}"
                 StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource Card}" Width="440" Margin="0,4,8,8">
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
              </Border.Effect>
              <StackPanel>
                <ItemsControl ItemsSource="{Binding DatasetOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReaderNode}">
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Options}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OptionNode}">
                              <Grid Margin="0,2">
                                <CheckBox Content="{Binding Option.DisplayName}" IsChecked="{Binding BoolValue}" ToolTip="{Binding Option.Description}"
                                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                  <TextBox DockPanel.Dock="Right" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                  <TextBlock Text="{Binding Option.DisplayName}" ToolTip="{Binding Option.Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Reload with these options" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Margin="0" />
              </StackPanel>
            </Border>
          </Popup>
          <Button Content="Reload" Command="{Binding RefreshCommand}" Margin="6,0,0,0" ToolTip="Read the data again from the programs (F5)" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Show in model" Command="{Binding ShowInModelCommand}" Margin="12,0,0,0"
                  ToolTip="Open the sheet / select and zoom to the selected rows in Revit or AutoCAD" />
          <Button Content="Columns…" Click="OnColumns" Margin="6,0,0,0" />
          <Button x:Name="ExcelButton" Content="Excel ▾" Click="OnDropDown" Margin="6,0,0,0">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Compare with linked workbook…" Command="{Binding CompareExcelCommand}" FontWeight="SemiBold" />
                <MenuItem Header="Link a workbook…" Command="{Binding LinkExcelCommand}" />
                <Separator />
                <MenuItem Header="Export this view to Excel…" Command="{Binding ExportExcelCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="⋯" Click="OnDropDown" Margin="6,0,0,0" Padding="10,4" ToolTip="More">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Export CSV (one row per item)…" Command="{Binding ExportCsvCommand}" />
                <MenuItem Header="Export CSV (one row per property)…" Command="{Binding ExportLongCsvCommand}" />
                <MenuItem Header="Export JSON…" Command="{Binding ExportJsonCommand}" />
                <Separator />
                <MenuItem Header="Sheet field matching (title block tags)…" Command="{Binding OpenSheetFieldsCommand}" />
                <MenuItem Header="Messages and log…" Click="OnMessages" />
                <MenuItem Header="Open log folder" Command="{Binding OpenLogFolderCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>

        <Grid Margin="16,0,0,0" MaxWidth="420" HorizontalAlignment="Left">
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="6,4" VerticalContentAlignment="Center" />
          <TextBlock Text="Search (Ctrl+F)" Foreground="#9AA0A6" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Bottom bar: summary, status, pending changes -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="#FFF6D5" BorderBrush="#F0D27A" BorderThickness="1" CornerRadius="4" Padding="10,4"
                Visibility="{Binding HasPendingEdits, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
            <Button Content="Review &amp; apply…" Command="{Binding ApplyChangesCommand}" Style="{StaticResource Primary}" />
            <Button Content="Discard" Command="{Binding DiscardChangesCommand}" Margin="0" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="{Binding IssuesText}" Style="{StaticResource LinkButton}" Click="OnMessages"
                  Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Status}" Foreground="#555" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="180" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="370" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <!-- Left: connected programs and files, Excel link -->
      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="EXCEL" Style="{StaticResource PanelTitle}" />
            <TextBlock Text="{Binding ExcelLinkTitle}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Compare…" Command="{Binding CompareExcelCommand}" Style="{StaticResource Primary}"
                      Visibility="{Binding HasExcelLink, Converter={StaticResource BoolToVis}}" />
              <Button Content="Link workbook…" Command="{Binding LinkExcelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="CONNECTED" Style="{StaticResource PanelTitle}" />
            <TextBlock DockPanel.Dock="Top" Text="Tick the files to include." Foreground="Gray" Margin="0,0,0,6" />
            <TreeView ItemsSource="{Binding Agents}" BorderThickness="0">
              <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:AgentNode}" ItemsSource="{Binding Documents}">
                  <StackPanel Margin="0,4,0,2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="Gray" FontSize="11" />
                    <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" MaxWidth="220" FontSize="11" />
                  </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type vm:DocumentNode}">
                  <CheckBox IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}" Margin="0,2">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" />
                      <TextBlock Text="{Binding Flags}" Foreground="Gray" FontSize="11" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </TreeView.Resources>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="True" />
                </Style>
              </TreeView.ItemContainerStyle>
            </TreeView>
          </DockPanel>
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- Center: the data -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <DataGrid x:Name="TableGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  HeadersVisibility="All" RowHeaderWidth="14" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#ECEEF1" VerticalGridLinesBrush="#ECEEF1" BorderThickness="0" Background="White"
                  BeginningEdit="OnBeginningEdit" PreviewKeyDown="OnGridKeyDown" SelectedCellsChanged="OnSelectedCellsChanged">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Show in model" Command="{Binding ShowInModelCommand}" FontWeight="SemiBold" />
              <Separator />
              <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
              <MenuItem Header="Paste" Click="OnPaste" InputGestureText="Ctrl+V" />
              <MenuItem Header="Set value for selected cells…" Click="OnSetValue" InputGestureText="F2" />
              <MenuItem Header="Fill down" Click="OnFillDown" InputGestureText="Ctrl+D" />
              <MenuItem Header="Find and replace…" Click="OnFindReplace" InputGestureText="Ctrl+H" />
              <MenuItem Header="Clear selected cells" Click="OnClear" InputGestureText="Delete" />
              <MenuItem Header="Revert selected cells" Click="OnRevert" InputGestureText="Ctrl+Z" />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
      </Border>

      <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- Right: everything about the selected row -->
      <Border Grid.Column="4" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="DETAILS" Style="{StaticResource PanelTitle}" />
            <TextBlock Text="{Binding SelectedTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedSubtitle}" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,6" />
            <Button Content="Show in model" Command="{Binding ShowInModelCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DetailGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DetailGroup}">
                  <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,4" FontWeight="SemiBold">
                    <ItemsControl ItemsSource="{Binding Rows}" FontWeight="Normal" Margin="4,2,0,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DetailRow}">
                          <Grid Margin="0,1" ToolTip="{Binding ToolTip}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="140" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="#444" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                     TextWrapping="Wrap" Padding="3,2" KeyDown="OnDetailKeyDown">
                              <TextBox.Style>
                                <Style TargetType="TextBox">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                      <Setter Property="Foreground" Value="#808080" />
                                      <Setter Property="Background" Value="#F7F7F7" />
                                      <Setter Property="BorderBrush" Value="#EEEEEE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                      <Setter Property="Background" Value="#FFF1B8" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBox.Style>
                            </TextBox>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
