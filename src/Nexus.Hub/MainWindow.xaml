<Window x:Class="Nexus.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="Nexus" Height="860" Width="1400" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="8">
    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Refresh hosts" Command="{Binding RefreshCommand}" />
      <Button Content="Run readers" Command="{Binding RunCommand}" FontWeight="SemiBold" />
      <Button Content="Show table" Command="{Binding ShowTableCommand}" />
      <Separator Margin="6,0" />
      <Button Content="{Binding ApplyLabel}" Command="{Binding ApplyChangesCommand}" FontWeight="SemiBold"
              ToolTip="Review your edits (old → new) and write them to the model." />
      <Button Content="Discard changes" Command="{Binding DiscardChangesCommand}" />
      <Separator Margin="6,0" />
      <Button Content="Export CSV (one row per item)" Command="{Binding ExportWideCommand}" />
      <Button Content="Export CSV (one row per property)" Command="{Binding ExportLongCommand}" />
      <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
      <Separator Margin="6,0" />
      <Button Content="Clear results" Command="{Binding ClearResultsCommand}" />
      <Button Content="Logs" Command="{Binding OpenLogFolderCommand}" />
    </StackPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4" Margin="0,6,0,0">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="2*" />
        <RowDefinition Height="5" />
        <RowDefinition Height="5*" />
      </Grid.RowDefinitions>

      <!-- Top: hosts/documents and readers -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Hosts and open documents (check the documents to read)" />
          <TreeView ItemsSource="{Binding Agents}">
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type vm:AgentNode}" ItemsSource="{Binding Documents}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Error}" Foreground="Firebrick" Margin="8,0,0,0" />
                </StackPanel>
              </HierarchicalDataTemplate>
              <DataTemplate DataType="{x:Type vm:DocumentNode}">
                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Title}" ToolTip="{Binding ToolTip}" />
              </DataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True" />
              </Style>
            </TreeView.ItemContainerStyle>
          </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Readers (options apply to every checked document of that host type)" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Readers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ReaderNode}">
                  <Expander Margin="0,0,0,2" Opacity="{Binding Opacity}">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="4,0,0,0" ToolTip="{Binding Descriptor.Description}" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="Gray" Margin="8,0,0,0" />
                      </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="24,2,0,6">
                      <TextBlock Text="{Binding Descriptor.Description}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,4" />
                      <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:OptionNode}">
                            <Grid Margin="0,1">
                              <CheckBox Content="{Binding Option.DisplayName}" IsChecked="{Binding BoolValue}" ToolTip="{Binding Option.Description}">
                                <CheckBox.Style>
                                  <Style TargetType="CheckBox">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsBool}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </CheckBox.Style>
                              </CheckBox>
                              <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                  <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsText}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Option.DisplayName}" Width="260" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />

      <!-- Bottom: results -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Results (checked = included in table and exports)" />
          <TextBox DockPanel.Dock="Bottom" Height="110" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Text="{Binding SelectedRunWarnings, Mode=OneWay}" Foreground="DarkGoldenrod" ToolTip="Warnings or error detail for the selected result" />
          <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRun}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ResultRun}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Top" Margin="0,2,4,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HostTitle}" Foreground="Gray" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxWidth="280">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Failed}" Value="True">
                              <Setter Property="Foreground" Value="Firebrick" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

        <TabControl Grid.Column="2">
          <TabItem Header="Table (double-click a value to edit)">
            <DataGrid x:Name="TableGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" FrozenColumnCount="5"
                      HeadersVisibility="Column" GridLinesVisibility="Vertical"
                      BeginningEdit="OnBeginningEdit" />
          </TabItem>

          <TabItem Header="Items (selected result)">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TreeView x:Name="ItemsTree" ItemsSource="{Binding Items}" SelectedItemChanged="OnItemSelected">
                <TreeView.Resources>
                  <HierarchicalDataTemplate DataType="{x:Type vm:ItemNode}" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Title}" />
                  </HierarchicalDataTemplate>
                </TreeView.Resources>
              </TreeView>
              <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
              <DataGrid Grid.Column="2" ItemsSource="{Binding SelectedProperties}" AutoGenerateColumns="False" IsReadOnly="True"
                        EnableRowVirtualization="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="180" />
                  <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="200" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="260" />
                  <DataGridTextColumn Header="Read-only" Binding="{Binding ReadOnly}" Width="70" />
                  <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="180" />
                  <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" />
                  <DataGridTextColumn Header="Storage" Binding="{Binding Storage}" Width="90" />
                  <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="110" />
                  <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="110" />
                  <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="200" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <TabItem Header="Columns (what goes in the table and exports)">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding ColumnFilter, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,0" />
                <Button Content="Check shown" Command="{Binding CheckAllColumnsCommand}" />
                <Button Content="Uncheck shown" Command="{Binding UncheckAllColumnsCommand}" />
                <Button Content="Show table" Command="{Binding ShowTableCommand}" />
              </StackPanel>
              <TreeView ItemsSource="{Binding FilteredColumnGroups}">
                <TreeView.Resources>
                  <HierarchicalDataTemplate DataType="{x:Type vm:ColumnGroupNode}" ItemsSource="{Binding Columns}">
                    <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="False" Content="{Binding Title}" FontWeight="SemiBold" />
                  </HierarchicalDataTemplate>
                  <DataTemplate DataType="{x:Type vm:ColumnNode}">
                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" />
                  </DataTemplate>
                </TreeView.Resources>
              </TreeView>
            </DockPanel>
          </TabItem>

          <TabItem Header="Log">
            <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" />
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
