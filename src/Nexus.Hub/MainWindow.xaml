<Window x:Class="Nexus.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="Nexus" Height="900" Width="1560" MinWidth="980" MinHeight="560" WindowStartupLocation="CenterScreen"
        Icon="Assets/Nexus.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <CollectionViewSource x:Key="DatasetsView" Source="{Binding Datasets}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Category" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <!-- Small grey caps label above a sidebar section. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Margin" Value="12,14,0,6" />
    </Style>

    <!-- Rounded surface for the grid, details and Excel panels. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Flat icon + text button for the command bar. -->
    <Style x:Key="CommandButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CommandToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Count on the Health button: red with errors, amber with warnings, blue with suggestions only. -->
    <Style x:Key="HealthBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Health.HasWarnings}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Health.HasErrors}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Icon for a health check's severity (DataContext has a Severity). -->
    <Style x:Key="SeverityGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Text" Value="&#xE946;" />
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Text" Value="&#xE7BA;" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter Property="Text" Value="&#xEA39;" />
          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Navigation item: icon + title, accent bar when selected. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="8,7">
              <Grid>
                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-6,0,0,0"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                <ContentPresenter Margin="6,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="272" MinWidth="200" MaxWidth="420" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===================== Sidebar ===================== -->
    <DockPanel Grid.Column="0" Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
      <!-- Brand -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,4">
        <Image x:Name="BrandLogo" Source="Assets/Nexus-dark.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="Nexus" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Excel link -->
      <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="10,8,10,12" Padding="12,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Background="#107C41" CornerRadius="4" Width="20" Height="20">
              <TextBlock Text="X" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Excel" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding ExcelLinkTitle}" TextWrapping="Wrap" Margin="0,6,0,8"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Compare" Command="{Binding CompareExcelCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,0"
                    Visibility="{Binding HasExcelLink, Converter={StaticResource BoolToVis}}" />
            <Button Content="Link workbook…" Command="{Binding LinkExcelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- Views -->
          <TextBlock Text="VIEWS" Style="{StaticResource SectionLabel}" />
          <ListBox ItemsSource="{Binding Source={StaticResource DatasetsView}}" SelectedItem="{Binding SelectedDataset}"
                   ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnNestedScroll">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="16,8,0,2" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DatasetNode}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                  <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" Width="22" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Files, per program -->
          <TextBlock Text="FILES" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="Open Revit, AutoCAD, Civil 3D or Plant 3D. They appear here automatically." TextWrapping="Wrap" Margin="14,0,14,0"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Agents.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Agents}" Margin="8,0,8,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AgentNode}">
                <StackPanel Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal" Margin="6,2,0,4">
                    <Grid Width="28" Height="28">
                      <!-- The Autodesk product icon, read from the installed program -->
                      <Image Source="{Binding ProductIcon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                             Visibility="{Binding HasProductIcon, Converter={StaticResource BoolToVis}}" />
                      <Border CornerRadius="5" Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                          <SolidColorBrush Color="{Binding BadgeColor}" />
                        </Border.Background>
                        <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                             FontSize="11" Margin="42,0,6,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </Trigger>
                          <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding EditNote}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                             FontSize="11" Margin="42,0,6,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ItemsControl ItemsSource="{Binding Documents}" Margin="36,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DocumentNode}">
                        <CheckBox IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}" Margin="0,2" MinHeight="0">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            <TextBlock Text="{Binding Flags}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" />

    <!-- ===================== Content ===================== -->
    <Grid Grid.Column="2" Margin="20,16,20,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title + search -->
      <DockPanel Grid.Row="0">
        <Border DockPanel.Dock="Right" Width="320" CornerRadius="6" VerticalAlignment="Center">
          <Grid>
            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="34,6,8,6" />
            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" />
            <TextBlock Text="Search  (Ctrl+F)   ·   Go to  (Ctrl+K)" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding SelectedDataset.Title}" FontSize="26" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button Style="{StaticResource CommandButton}" Click="OnMessages" Padding="6,0" Margin="8,0,0,0"
                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding IssuesText}" Margin="5,0,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- Command bar -->
      <DockPanel Grid.Row="1" Margin="-8,12,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton Style="{StaticResource CommandToggle}" IsChecked="{Binding ShowDetails}" ToolTip="Show or hide the details pane">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A0;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Details" Margin="8,0,0,0" />
            </StackPanel>
          </ToggleButton>
          <Button Style="{StaticResource CommandButton}" Click="OnDropDown" ToolTip="More">
            <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}" />
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Export CSV (one row per item)…" Command="{Binding ExportCsvCommand}" />
                <MenuItem Header="Export CSV (one row per property)…" Command="{Binding ExportLongCsvCommand}" />
                <MenuItem Header="Export JSON…" Command="{Binding ExportJsonCommand}" />
                <Separator />
                <MenuItem Header="Sheet field matching (title block tags)…" Command="{Binding OpenSheetFieldsCommand}" />
                <MenuItem Header="Messages and log…" Click="OnMessages" />
                <MenuItem Header="Open log folder" Command="{Binding OpenLogFolderCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource CommandButton}" Command="{Binding ShowInModelCommand}"
                  ToolTip="Open the sheet, or select and zoom to the selected rows, in Revit / AutoCAD / Civil 3D / Plant 3D">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Show in model" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource CommandButton}" Command="{Binding RefreshCommand}" ToolTip="Read the data again (F5)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Reload" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource CommandButton}" Click="OnRename" ToolTip="Rename and renumber the selected rows (or every row shown), with a preview">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8AC;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Rename" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource CommandButton}" Click="OnHistory" ToolTip="Snapshots: what changed since an issue, and every change applied with Nexus">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" />
              <TextBlock Text="History" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <ToggleButton Style="{StaticResource CommandToggle}" IsChecked="{Binding Health.IsOpen}"
                        Visibility="{Binding Health.IsAvailable, Converter={StaticResource BoolToVis}}"
                        ToolTip="Sheet health: checks every sheet in the open files (duplicate numbers, template placeholders, naming, spaces...)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE95E;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Health" Margin="8,0,0,0" />
              <Border Style="{StaticResource HealthBadge}" Margin="8,0,0,0" Visibility="{Binding Health.HasIssues, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Health.BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12" Margin="8,0,0,0"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                         Visibility="{Binding Health.IsHealthy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
          </ToggleButton>
          <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
          <Button Style="{StaticResource CommandButton}" Click="OnColumns" ToolTip="Choose the columns">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Columns" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <ToggleButton x:Name="OptionsToggle" Style="{StaticResource CommandToggle}" ToolTip="What this view includes"
                        Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Options" Margin="8,0,0,0" />
            </StackPanel>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked, ElementName=OptionsToggle}" PlacementTarget="{Binding ElementName=OptionsToggle}"
                 StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Width="460" Margin="0,6,10,10" Padding="16">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" />
              </Border.Effect>
              <StackPanel>
                <ItemsControl ItemsSource="{Binding DatasetOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReaderNode}">
                      <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Options}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OptionNode}">
                              <Grid Margin="0,2">
                                <CheckBox Content="{Binding Option.DisplayName}" IsChecked="{Binding BoolValue}" ToolTip="{Binding Option.Description}"
                                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                  <TextBox DockPanel.Dock="Right" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                                  <TextBlock Text="{Binding Option.DisplayName}" ToolTip="{Binding Option.Description}" TextWrapping="Wrap"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                </DockPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Reload with these options" Command="{Binding RefreshCommand}" Style="{DynamicResource AccentButtonStyle}"
                        HorizontalAlignment="Right" />
              </StackPanel>
            </Border>
          </Popup>
          <Button Style="{StaticResource CommandButton}" Click="OnDropDown" ToolTip="Compare with, link or export to Excel">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE9F9;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Excel" Margin="8,0,0,0" />
              <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Compare with linked workbook…" Command="{Binding CompareExcelCommand}" FontWeight="SemiBold" />
                <MenuItem Header="Link a workbook…" Command="{Binding LinkExcelCommand}" />
                <Separator />
                <MenuItem Header="Export this view to Excel…" Command="{Binding ExportExcelCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </DockPanel>

      <!-- Grid + details -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" ClipToBounds="True">
          <Grid>
            <DataGrid x:Name="TableGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeRows="False"
                      SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      HeadersVisibility="All" RowHeaderWidth="10" GridLinesVisibility="Horizontal" MinRowHeight="34"
                      HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                      BeginningEdit="OnBeginningEdit" PreviewKeyDown="OnGridKeyDown" SelectedCellsChanged="OnSelectedCellsChanged"
                      PreviewMouseRightButtonDown="OnGridRightButtonDown" ContextMenuOpening="OnGridContextMenuOpening">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <!-- Filled when the menu opens: one tickable item per revision for the selected sheet(s). -->
                  <MenuItem x:Name="RevisionsMenu" Header="Revisions" />
                  <Separator x:Name="RevisionsSeparator" />
                  <MenuItem Header="Show in model" Command="{Binding ShowInModelCommand}" />
                  <Separator />
                  <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                  <MenuItem Header="Paste" Click="OnPaste" InputGestureText="Ctrl+V" />
                  <MenuItem Header="Set value for selected cells…" Click="OnSetValue" InputGestureText="F2" />
                  <MenuItem Header="Fill down" Click="OnFillDown" InputGestureText="Ctrl+D" />
                  <MenuItem Header="Find and replace…" Click="OnFindReplace" InputGestureText="Ctrl+H" />
                  <MenuItem Header="Rename and renumber…" Click="OnRename" InputGestureText="Ctrl+R" />
                  <MenuItem Header="Clear selected cells" Click="OnClear" InputGestureText="Delete" />
                  <MenuItem Header="Revert selected cells" Click="OnRevert" InputGestureText="Ctrl+Z" />
                </ContextMenu>
              </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding SelectedDataset.Icon}" Style="{StaticResource Glyph}" FontSize="40" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
              <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Sheet health -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Width="380" Margin="12,0,0,0" Padding="16,14"
                Visibility="{Binding Health.IsOpen, Converter={StaticResource BoolToVis}}">
          <DockPanel DataContext="{Binding Health}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Click="OnCloseHealth" ToolTip="Close" Padding="6" Background="Transparent" BorderThickness="0">
                  <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12" />
                </Button>
                <TextBlock Text="Sheet health" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,10"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <StackPanel Visibility="{Binding HasFixes, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding FixAllCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE90F;" Style="{StaticResource Glyph}" FontSize="13" />
                    <TextBlock Text="{Binding FixAllText}" Margin="8,0,0,0" />
                  </StackPanel>
                </Button>
                <TextBlock Text="Fixes are staged like your own edits: nothing changes in the files until Review &amp; apply."
                           TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </StackPanel>

            <Grid>
              <!-- All good -->
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                          Visibility="{Binding IsHealthy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE930;" Style="{StaticResource Glyph}" FontSize="44" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="Looking good" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock Text="No duplicate numbers, placeholders or naming problems." TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthGroup}">
                      <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,6">
                        <Expander.Header>
                          <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding FixAllText}" Command="{Binding FixAllCommand}" Padding="8,2" FontSize="12"
                                    Visibility="{Binding CanFixAll, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0" />
                            <TextBlock Style="{StaticResource SeverityGlyph}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                              <Run Text="{Binding Count, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                          </DockPanel>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,2,0,2">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HealthItem}">
                              <Border CornerRadius="6" Padding="10,8" Margin="0,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel>
                                  <Button Command="{Binding ShowCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                                          HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip="Show this sheet in the table">
                                    <StackPanel>
                                      <TextBlock Text="{Binding Where}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                  </Button>
                                  <Button Content="{Binding FixText}" Command="{Binding FixCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                          Padding="10,3" FontSize="12" Visibility="{Binding CanFix, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Width="360" Margin="12,0,0,0" Padding="16,14"
                Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="{Binding SelectedTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedSubtitle}" TextWrapping="Wrap" Margin="0,2,0,10"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Button Command="{Binding ShowInModelCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="13" />
                  <TextBlock Text="Show in model" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding DetailGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DetailGroup}">
                    <Expander IsExpanded="True" Margin="0,0,0,6">
                      <Expander.Header>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4,0,4">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:DetailRow}">
                            <StackPanel Margin="0,3" ToolTip="{Binding ToolTip}">
                              <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                              <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                       TextWrapping="Wrap" KeyDown="OnDetailKeyDown">
                                <TextBox.Style>
                                  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0,2" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBox.Style>
                              </TextBox>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Status + changes -->
      <DockPanel Grid.Row="3" Margin="0,12,0,0">
        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="14,8" Margin="12,0,0,0"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding HasPendingEdits, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0" />
            <Button Content="Discard" Command="{Binding DiscardChangesCommand}" Margin="0,0,8,0" />
            <Button Content="Review &amp; apply" Command="{Binding ApplyChangesCommand}" Style="{DynamicResource AccentButtonStyle}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
