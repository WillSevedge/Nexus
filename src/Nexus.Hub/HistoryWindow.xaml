<Window x:Class="Nexus.Hub.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="Nexus - History" Height="720" Width="1120" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/Nexus.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="KindPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Added">
          <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Removed">
          <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Margin="24,18,24,20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="History" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="See what changed in your sheets since any point, and every change Nexus applied."
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Close" IsCancel="True" Padding="16,6" />
    </StackPanel>

    <TabControl Background="Transparent" BorderThickness="0">
      <!-- Snapshots and comparison -->
      <TabItem Header="What changed">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <DockPanel>
            <Border DockPanel.Dock="Top" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel>
                <TextBlock Text="Take a snapshot" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SnapshotHint}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,8"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <DockPanel IsEnabled="{Binding CanSnapshot}">
                  <Button DockPanel.Dock="Right" Content="Save" Command="{Binding TakeSnapshotCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" />
                  <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name, e.g. 50% CD issue" />
                </DockPanel>
              </StackPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button Content="Delete" Command="{Binding DeleteCommand}" HorizontalAlignment="Left" Padding="10,3" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SnapshotItem}">
                  <StackPanel Margin="2,4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Command="{Binding ExportCommand}" Padding="10,4" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                  <TextBlock Text="Export to Excel" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <StackPanel>
                <TextBlock Text="{Binding CompareSummary}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CompareNote}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </DockPanel>
            <Grid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding HasNoDifferences, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE930;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="No differences" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Differences}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SheetDiffItem}">
                      <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderThickness="1"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding File}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border Style="{StaticResource KindPill}" Margin="0,0,10,0">
                              <TextBlock Text="{Binding KindText}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding Sheet}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding Fields}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <WrapPanel Margin="0,2">
                                  <TextBlock Text="{Binding Field}" Width="220" TextTrimming="CharacterEllipsis"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="{Binding Before}" TextDecorations="Strikethrough" Margin="0,0,8,0"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                  <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"
                                             Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                  <TextBlock Text="{Binding After}" FontWeight="SemiBold" />
                                </WrapPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- Change log -->
      <TabItem Header="Change log">
        <DockPanel Margin="0,10,0,0">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox DockPanel.Dock="Right" Width="280" Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="Search file, sheet, property, value or user" />
            <TextBlock Text="{Binding LogSummary}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding LogEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal" EnableRowVirtualization="True"
                    HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="When" Binding="{Binding When}" Width="140" />
              <DataGridTextColumn Header="Who" Binding="{Binding User}" Width="90" />
              <DataGridTextColumn Header="File" Binding="{Binding File}" Width="150" />
              <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="1.2*" />
              <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*" />
              <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*" />
              <DataGridTextColumn Header="After" Binding="{Binding After}" Width="*" FontWeight="SemiBold" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
