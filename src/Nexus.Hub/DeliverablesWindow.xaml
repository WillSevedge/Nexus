<Window x:Class="Nexus.Hub.DeliverablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="{Binding Title}" Height="760" Width="1400" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="Assets/Nexus.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <DockPanel Margin="20">
    <!-- Workbook and the one thing Nexus writes. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="Read the workbook (as last saved) and the loaded sheets again." />
        <Button Content="Export to Model" Command="{Binding ExportCommand}" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                ToolTip="Fill the workbook's Model Export tab with the model's sheets. Nothing else in the workbook is written." />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding WorkbookPath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="700" />
        <Button Content="Change…" Command="{Binding ChangeWorkbookCommand}" Margin="8,0,0,0" Padding="8,2" />
      </StackPanel>
    </DockPanel>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{x:Static vm:DeliverablesViewModel.Filters}" SelectedItem="{Binding Filter}" Width="150" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding HasTargets, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="New sheets go in" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Title" MinWidth="220"
                    ToolTip="The Revit model that gets sheets for drawings that are on the list but not in the model." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Excel selection" Command="{Binding ExcelSelectionCommand}" Margin="8,0,0,0"
                  ToolTip="Select here the drawings you have selected in Excel (rows of the deliverables list, or cells with drawing numbers)." />
          <Button Content="{Binding MatchText}" Command="{Binding MatchCommand}" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                  ToolTip="Make the model match the list for the selected drawings: new sheets for drawings the model does not have, the list's values for the ones that differ (then Review &amp; apply)." />
          <Button Content="Close" IsCancel="True" Click="OnClose" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 Text="The workbook is the source of truth: Nexus never writes the deliverables list. Select drawings here (Ctrl/Shift+click, Ctrl+A) or in Excel, then Match model to list. Export to Model fills the Model Export tab." />
    </StackPanel>

    <Grid>
      <DataGrid x:Name="Grid" ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                HeadersVisibility="Column" GridLinesVisibility="Vertical" VerticalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                EnableRowVirtualization="True" SelectionUnit="FullRow" SelectionMode="Extended" IsReadOnly="True" FrozenColumnCount="1"
                SelectionChanged="OnSelectionChanged" />
      <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DockPanel>
</Window>
