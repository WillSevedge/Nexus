<Window x:Class="Nexus.Hub.DeliverablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="{Binding Title}" Height="800" Width="1440" MinWidth="980" MinHeight="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="Assets/Nexus.ico"
        Background="{DynamicResource Nexus.Background}" Foreground="{DynamicResource Nexus.Text}"
        FontFamily="{StaticResource Nexus.Font}" FontSize="{StaticResource Nexus.FontSize.Body}">
  <!--
    The deliverables list (read-only, the source of truth) next to the open models. Each difference can be pushed
    from the list into the model; drawings the models lack can become new sheets. Push to models stages the ticked
    values and opens the review, which writes them.
  -->
  <Window.Resources>
    <!-- Filter chip: a radio button that looks like a pill with a count. -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" CornerRadius="14" Padding="12,5" Background="{DynamicResource Nexus.Surface}"
                    BorderBrush="{DynamicResource Nexus.Border}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A compact tick box (no label). -->
    <Style x:Key="Tick" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- One field: the list's value; when the model differs, the model's value under it and a tick to push. -->
    <DataTemplate x:Key="FieldCell" DataType="{x:Type vm:FieldCompare}">
      <DockPanel Margin="8,6" ToolTip="{Binding ToolTip}" Background="Transparent">
        <Grid DockPanel.Dock="Left" Width="22" VerticalAlignment="Top" Margin="0,0,4,0">
          <CheckBox IsChecked="{Binding Push}" Style="{StaticResource Tick}" VerticalAlignment="Top"
                    Visibility="{Binding CanPush, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="12" VerticalAlignment="Top" Margin="2,3,0,0"
                     Foreground="{DynamicResource Nexus.TextTertiary}"
                     Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Differs}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding HasModel}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding ModelText}" FontSize="{StaticResource Nexus.FontSize.Small}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                     Visibility="{Binding Differs, Converter={StaticResource BoolToVis}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
                <Style.Triggers>
                  <!-- Ticked: the model's value is the one being replaced. -->
                  <DataTrigger Binding="{Binding Push}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextTertiary}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="24,20,24,16">
    <!-- Header -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Command="{Binding ChangeWorkbookCommand}" Style="{StaticResource Nexus.SecondaryButton}" Content="Change workbook…" Margin="0,0,8,0" />
        <Button Command="{Binding RefreshCommand}" Style="{StaticResource Nexus.SecondaryButton}" ToolTip="Read the workbook (as last saved) and the models again">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13" />
            <TextBlock Text="Refresh" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Deliverables" Style="{StaticResource Nexus.Text.Heading}" />
          <TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" FontSize="16" Margin="10,2,10,0" Foreground="{DynamicResource Nexus.Accent}" />
          <TextBlock Text="Models" Style="{StaticResource Nexus.Text.Heading}" />
        </StackPanel>
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Nexus.Text.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkbookPath}">
          <Run Text="{Binding WorkbookName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Nexus.Text}" />
          <Run Text="  ·  " />
          <Run Text="{Binding Summary, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding ReadAt}" Style="{StaticResource Nexus.Text.Caption}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Filters and selection -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Command="{Binding ExcelSelectionCommand}" Style="{StaticResource Nexus.CommandButton}"
                ToolTip="Tick only the drawings selected in Excel (rows of the deliverables list, or cells with drawing numbers)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B3;" Style="{StaticResource Glyph}" FontSize="13" />
            <TextBlock Text="Use Excel selection" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Rectangle Style="{StaticResource Nexus.Divider}" />
        <Button Command="{Binding TickAllCommand}" Style="{StaticResource Nexus.CommandButton}" Content="Tick all" ToolTip="Tick every row shown" />
        <Button Command="{Binding TickNoneCommand}" Style="{StaticResource Nexus.CommandButton}" Content="Tick none" ToolTip="Untick every row shown" />
      </StackPanel>
      <WrapPanel VerticalAlignment="Center">
        <RadioButton GroupName="Filter" Style="{StaticResource FilterChip}" IsChecked="{Binding IsNeedsPush}"
                     ToolTip="Drawings that differ, and drawings the models do not have yet">
          <TextBlock><Run Text="To push" /><Run Text="  " /><Run Text="{Binding CountNeedsPush, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </RadioButton>
        <RadioButton GroupName="Filter" Style="{StaticResource FilterChip}" IsChecked="{Binding IsDiffers}">
          <TextBlock><Run Text="Differs" /><Run Text="  " /><Run Text="{Binding CountDiffers, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </RadioButton>
        <RadioButton GroupName="Filter" Style="{StaticResource FilterChip}" IsChecked="{Binding IsNew}"
                     ToolTip="On the list, not in the open models">
          <TextBlock><Run Text="New sheets" /><Run Text="  " /><Run Text="{Binding CountNew, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </RadioButton>
        <RadioButton GroupName="Filter" Style="{StaticResource FilterChip}" IsChecked="{Binding IsNotOnList}"
                     ToolTip="In the models, not on the list (add them to the list in Excel)">
          <TextBlock><Run Text="Not on list" /><Run Text="  " /><Run Text="{Binding CountNotOnList, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </RadioButton>
        <RadioButton GroupName="Filter" Style="{StaticResource FilterChip}" IsChecked="{Binding IsMatch}">
          <TextBlock><Run Text="Match" /><Run Text="  " /><Run Text="{Binding CountMatch, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </RadioButton>
        <RadioButton GroupName="Filter" Style="{StaticResource FilterChip}" IsChecked="{Binding IsAll}">
          <TextBlock><Run Text="All" /><Run Text="  " /><Run Text="{Binding CountAll, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </RadioButton>
      </WrapPanel>
    </DockPanel>

    <!-- Action bar -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Nexus.Card}" Padding="16,12" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Command="{Binding ExportCommand}" Style="{StaticResource Nexus.SecondaryButton}" Margin="0,0,8,0"
                  Content="Export models → Model Export tab"
                  ToolTip="Fill the workbook's Model Export tab with the models' sheets. Nothing else in the workbook is written." />
          <Button Command="{Binding PushCommand}" Style="{StaticResource Nexus.PrimaryButton}"
                  ToolTip="Create the ticked new sheets, then review and write the ticked values into the models">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="13" />
              <TextBlock Text="{Binding PushText}" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button Content="Close" IsCancel="True" Click="OnClose" Style="{StaticResource Nexus.CommandButton}" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding PushSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasNewToPush, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="New sheets go in" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Nexus.Text.Secondary}" />
            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Title" MinWidth="240"
                      Visibility="{Binding HasTargets, Converter={StaticResource BoolToVis}}"
                      ToolTip="The Revit model that gets sheets for drawings that are on the list but not in the models" />
          </StackPanel>
          <TextBlock Text="{Binding Message}" Style="{StaticResource Nexus.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="64" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The comparison -->
    <Border Style="{StaticResource Nexus.Card}" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="Grid" ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Nexus.Border}"
                  BorderThickness="0" Background="Transparent" RowBackground="Transparent" ColumnHeaderHeight="36"
                  EnableRowVirtualization="True" SelectionUnit="FullRow" SelectionMode="Extended" IsReadOnly="True" FrozenColumnCount="2"
                  KeyDown="OnGridKeyDown">
          <DataGrid.Resources>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource Nexus.GridCell}">
              <Setter Property="Padding" Value="0" />
            </Style>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource Nexus.GridRow}" />
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Nexus.GridColumnHeader}" />
          </DataGrid.Resources>
          <DataGrid.Columns>
            <!-- Row tick: everything pushable on the row (or the new sheet). -->
            <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
              <DataGridTemplateColumn.Header>
                <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="12" ToolTip="Push from the list into the model" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <CheckBox IsChecked="{Binding Push, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Tick}"
                            Visibility="{Binding CanPush, Converter={StaticResource BoolToVis}}"
                            ToolTip="Push this drawing's ticked values (or create the sheet)" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Dwg/Doc No." Width="130" SortMemberPath="Number">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <StackPanel Margin="10,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Discipline}" Style="{StaticResource Nexus.Text.Caption}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Result" Width="112" SortMemberPath="ResultText">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <Border CornerRadius="10" Padding="8,2" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding ResultToolTip}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Nexus.SuccessSubtle}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Nexus.Success}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Result}" Value="Differs">
                            <Setter Property="Background" Value="{DynamicResource Nexus.WarningSubtle}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Nexus.Warning}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Result}" Value="NotInModel">
                            <Setter Property="Background" Value="{DynamicResource Nexus.InfoSubtle}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Nexus.Info}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Result}" Value="NotOnList">
                            <Setter Property="Background" Value="{DynamicResource Nexus.SurfaceAlt}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ResultText}" FontSize="{StaticResource Nexus.FontSize.Small}" FontWeight="SemiBold" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Sheet name" Width="2*" MinWidth="220">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <ContentControl Content="{Binding Title}" ContentTemplate="{StaticResource FieldCell}" Focusable="False" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Rev" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <ContentControl Content="{Binding Rev}" ContentTemplate="{StaticResource FieldCell}" Focusable="False" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Date" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <ContentControl Content="{Binding Date}" ContentTemplate="{StaticResource FieldCell}" Focusable="False" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Status" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource FieldCell}" Focusable="False" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="In the model" Width="1*" MinWidth="180" SortMemberPath="Source">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:DeliverableRow}">
                  <TextBlock Text="{Binding Source}" Margin="10,6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Source}" Foreground="{DynamicResource Nexus.TextSecondary}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <!-- Nothing in this filter -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding IsEmptyView, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="&#xE930;" Style="{StaticResource Glyph}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource Nexus.Success}" />
          <TextBlock Text="Nothing here" Style="{StaticResource Nexus.Text.Section}" HorizontalAlignment="Center" Margin="0,10,0,4" />
          <TextBlock Text="No drawing in this view. Pick another filter above, or Refresh after changing the list in Excel (save it there first)."
                     Style="{StaticResource Nexus.Text.Secondary}" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</Window>
