<Window x:Class="Nexus.Hub.ExcelLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus - Link an Excel workbook" Height="620" Width="760" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="Assets/Nexus.ico" Background="#F5F6F8">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#444" Margin="0,0,0,10"
               Text="Link your sheet index or template once. Nexus remembers it, compares it with the model, and can update either side." />

    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Workbook" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding WorkbookPath, Mode=OneWay}" IsReadOnly="True" Margin="0,2" Padding="4,3" />
      <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,2,0,2" />

      <TextBlock Grid.Row="1" Text="Worksheet" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" DisplayMemberPath="Name" Margin="0,2" />

      <TextBlock Grid.Row="2" Text="Header row" VerticalAlignment="Center" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
        <TextBox Text="{Binding HeaderRow, UpdateSourceTrigger=LostFocus}" Width="60" Padding="4,3" />
        <TextBlock Text="the row with the column titles (found automatically)" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>

      <TextBlock Grid.Row="3" Text="Match rows on" VerticalAlignment="Center" />
      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
        <ComboBox ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding KeyHeader}" Width="220" />
        <TextBlock Text="usually the sheet number" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#1F4E8C" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save link" Click="OnSave" IsDefault="True" FontWeight="SemiBold" />
        <Button Content="Cancel" IsCancel="True" />
      </StackPanel>
    </StackPanel>

    <DataGrid ItemsSource="{Binding Mappings}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E6E6" Background="White">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Excel column" Binding="{Binding Header}" IsReadOnly="True" Width="240" />
        <DataGridTemplateColumn Header="Nexus column" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.ColumnChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValuePath="Id" DisplayMemberPath="Label"
                        SelectedValue="{Binding ColumnId, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
