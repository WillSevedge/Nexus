<Window x:Class="Nexus.Hub.MarkupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Hub.ViewModels"
        Title="Nexus - PDFs &amp; markups" Height="820" Width="1520" MinWidth="980" MinHeight="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="Assets/Nexus.ico" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <DockPanel Margin="20">
    <!-- The PDFs -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="Add files…" Command="{Binding AddCommand}" Style="{DynamicResource AccentButtonStyle}"
                ToolTip="PDFs (a set or single sheets), or a markup list exported from Bluebeam as CSV. They are only read." />
        <Button Content="Watch folder…" Command="{Binding AddFolderCommand}" Margin="8,0,0,0"
                ToolTip="Every PDF in a folder and its subfolders, now and whenever one is added or saved there." />
        <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="8,0,0,0" ToolTip="Stop reading the selected file or folder (nothing is changed or deleted)." />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="Read every file again." />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="PDFs &amp; markups" FontSize="16" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8"
                   Text="Everything in the PDFs: markups with every value stored on them, pages (sheet, size, scale), the text printed on the pages, and what each file says about itself. Add files, watch a folder, or drop either here. For a Studio Session that is still running, add its markup list exported from Bluebeam as CSV." />
        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MaxHeight="76" BorderThickness="0"
                 Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </DockPanel>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{Binding ScansText}" Command="{Binding ReadScansCommand}" Margin="0,0,12,0"
                Visibility="{Binding HasScans, Converter={StaticResource BoolToVis}}"
                ToolTip="Some pages are only a picture (scans). This reads their text with the text recognition built into Windows: nothing leaves this PC. It takes a few seconds a page and is kept for next time." />
        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="220" Margin="0,0,12,0"
                 ToolTip="Search every list: sheets, comments, authors, replies, the text on the pages and any other value" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsMarkupsTab, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{x:Static vm:MarkupsViewModel.Filters}" SelectedItem="{Binding Filter}" Width="200" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Show sheet in model" Command="{Binding ShowInModelCommand}"
                ToolTip="Open the sheets of the selected markups in Revit or AutoCAD." />
        <Button Content="Open PDF" Command="{Binding OpenPdfCommand}" Margin="8,0,0,0" ToolTip="Open the PDF in Bluebeam (your default PDF program)." />
        <Button Content="Export to Excel…" Command="{Binding ExportCommand}" Margin="8,0,0,0" ToolTip="The list shown (Markups, Pages, Text or Document) as a workbook, with every value as a column." />
        <Button Content="Close" IsCancel="True" Click="OnClose" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="380" MinWidth="220" />
      </Grid.ColumnDefinitions>
      <TabControl SelectedIndex="{Binding Tab}" Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="Markups">
          <DataGrid x:Name="Grid" ItemsSource="{Binding View}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    SelectionMode="Extended" SelectionUnit="FullRow" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    MouseDoubleClick="OnDoubleClick" SelectionChanged="OnMarkupSelected">
            <DataGrid.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,10,0,4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ItemCount, StringFormat='   {0} shown'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOpen}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsOpen}" Value="False">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="55" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="95" />
              <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="130" />
              <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="ToolTip" Value="{Binding Comment}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="130" />
              <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130" SortMemberPath="When" />
              <DataGridTextColumn Header="Replies" Binding="{Binding Replies}" Width="65">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="ToolTip" Value="{Binding RepliesText}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="110" />
              <DataGridTextColumn Header="File" Binding="{Binding File}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Pages">
          <DataGrid x:Name="PagesGrid" ItemsSource="{Binding PagesView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OnPageSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Header="File" Binding="{Binding File}" Width="2*" />
              <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="55" />
              <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="90" />
              <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="100" />
              <DataGridTextColumn Header="Bookmark" Binding="{Binding Bookmark}" Width="2*" />
              <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
              <DataGridTextColumn Header="Paper" Binding="{Binding Paper}" Width="90" />
              <DataGridTextColumn Header="Rotation" Binding="{Binding Rotation}" Width="70" />
              <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="130" />
              <DataGridTextColumn Header="Markups" Binding="{Binding Markups}" Width="70" />
              <DataGridTextColumn Header="Content" Binding="{Binding Content}" Width="150" />
              <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="60" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Text">
          <DataGrid ItemsSource="{Binding TextView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="90" />
              <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="55" />
              <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Text}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="120" SortMemberPath="FromLeft" />
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110" />
              <DataGridTextColumn Header="File" Binding="{Binding File}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Document">
          <DataGrid ItemsSource="{Binding DocumentView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    SelectionMode="Extended" SelectionUnit="FullRow" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <DataGrid.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,10,0,4" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />
      <!-- Every value of the markup or page selected last -->
      <Border Grid.Column="2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
            <TextBlock Text="All values" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DetailsTitle}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding DetailsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="None" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                    SelectionMode="Extended" SelectionUnit="FullRow" Margin="6,0,6,8">
            <DataGrid.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,10,0,4" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding Name}" Width="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Value}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <ProgressBar Grid.ColumnSpan="3" IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DockPanel>
</Window>
