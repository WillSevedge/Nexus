<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plant 3D module. Loaded at runtime by the core agent when AutoCAD Plant 3D is detected (modules.json).
       It reaches the Plant 3D API (PnPProjectManagerMgd, PnPDataLinks) by late binding, so it builds on
       machines without Plant 3D and never pins a Plant 3D API version. -->
  <PropertyGroup>
    <TargetFramework>$(HostTargetFramework)</TargetFramework>
    <!-- The AutoCAD 2026 API references the Windows Desktop WindowsBase (WPF); avoids MSB3277. -->
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Nexus.Agent.Acad.Plant3D</RootNamespace>
    <AssemblyName>Nexus.Agent.Acad.Plant3D</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings (Path clash with WPF shapes, not used here). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core agent is already loaded by AutoCAD; do not copy it again. -->
    <ProjectReference Include="..\Nexus.Agent.Acad\Nexus.Agent.Acad.csproj" Private="false" />
    <ProjectReference Include="..\Nexus.Agent.Shared\Nexus.Agent.Shared.csproj" Private="false" />
    <ProjectReference Include="..\Nexus.Contracts\Nexus.Contracts.csproj" Private="false" />
  </ItemGroup>

  <Import Project="..\..\build\AutoCad.targets" />

  <Target Name="NexusDeployPlantModule" AfterTargets="Build" DependsOnTargets="NexusCheckAcadRunning"
          Condition="'$(OS)' == 'Windows_NT' and '$(DeployToHost)' != 'false' and '$(_NexusAcadInUse)' != 'true'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(AcadBundleContentDir)"
          SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Nexus: deployed Plant 3D module to $(AcadBundleContentDir)" />
  </Target>
</Project>
