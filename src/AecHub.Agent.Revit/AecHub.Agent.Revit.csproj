<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(HostTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The Revit 2026 API references the Windows Desktop builds of System.Drawing and
         Microsoft.VisualBasic (WinForms profile). Referencing that profile too avoids
         MSB3277 version conflicts. -->
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AecHub.Agent.Revit</RootNamespace>
    <AssemblyName>AecHub.Agent.Revit</AssemblyName>
    <!-- Plugin-style output: our own dependencies are copied next to the add-in. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the implicit usings: their Form, Color, Point etc.
         clash with Revit and WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AecHub.Agent.Shared\AecHub.Agent.Shared.csproj" />
    <ProjectReference Include="..\AecHub.Contracts\AecHub.Contracts.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\Revit.targets" />
</Project>
