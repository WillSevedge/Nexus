<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(HostTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The Revit 2026 API references the Windows Desktop builds of System.Drawing and
         Microsoft.VisualBasic (WinForms profile). Referencing that profile too avoids
         MSB3277 version conflicts. -->
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Nexus.Agent.Revit</RootNamespace>
    <AssemblyName>Nexus.Agent.Revit</AssemblyName>
    <!-- Plugin-style output: our own dependencies are copied next to the add-in. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the implicit usings: their Form, Color, Point etc.
         clash with Revit and WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nexus N ribbon images and the code that adds the status dot (shared with the other add-in). -->
    <Compile Include="..\Common\RibbonIcons.cs" Link="Common\RibbonIcons.cs" />
    <EmbeddedResource Include="..\Common\Resources\Nexus-16.png" LogicalName="Nexus-16.png" Link="Common\Nexus-16.png" />
    <EmbeddedResource Include="..\Common\Resources\Nexus-32.png" LogicalName="Nexus-32.png" Link="Common\Nexus-32.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexus.Agent.Shared\Nexus.Agent.Shared.csproj" />
    <ProjectReference Include="..\Nexus.Contracts\Nexus.Contracts.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\Revit.targets" />
</Project>
