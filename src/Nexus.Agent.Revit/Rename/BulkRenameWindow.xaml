<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Nexus - Bulk Rename" Width="1560" Height="940" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="12.5">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />

    <!-- ===== Inputs ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource InputBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrong}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Code" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="3,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MaxDropDownHeight" Value="360" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0"
                            Stroke="{DynamicResource TextDim}" StrokeThickness="1.4" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrong}" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="8,0,26,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
              <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Margin="6,1,24,1" VerticalAlignment="Center"
                       Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                       IsReadOnly="{TemplateBinding IsReadOnly}" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6"
                        Padding="0,3" Margin="0,3,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="Shown" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Check box: a rounded box with a tick. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                      Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource LineStrong}">
                <Path x:Name="Tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="-1,-1,0,0" />
              </Border>
              <ContentPresenter x:Name="Text" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Text" Property="Margin" Value="0" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch for each step. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" BorderThickness="1"
                    Background="Transparent" BorderBrush="{DynamicResource TextDim}">
              <Ellipse x:Name="Knob" Width="10" Height="10" Fill="{DynamicResource TextDim}" HorizontalAlignment="Left" Margin="3,0,0,0" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Knob" Property="Fill" Value="White" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                <Setter TargetName="Knob" Property="Width" Value="12" />
                <Setter TargetName="Knob" Property="Height" Value="12" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="26" />
    </Style>

    <!-- Thin scroll bars -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bd" Background="{DynamicResource Scroll}" CornerRadius="4" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource TextDim}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
              <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="10" />
          <Setter Property="MinHeight" Value="10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                  <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Layout pieces ===== -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <sys:Boolean x:Key="False">False</sys:Boolean>

    <!--
      A rule panel (like Bulk Rename Utility): every panel is always visible, numbered in the order the rules run.
      Header: title and number on the left, the on/off tick on the right (Tag="On"). The body is dimmed while the
      panel is off; typing in it turns it on (code).
    -->
    <Style x:Key="Rule" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource StepBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8,10,10" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style x:Key="RuleTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RuleNumber" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <!-- Body: Tag is bound to the header tick; dimmed while off. -->
    <Style x:Key="RuleBody" TargetType="Grid">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="{StaticResource False}">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="200" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Rename items in" Style="{StaticResource Label}" Margin="0,0,10,0" />
        <ComboBox x:Name="ScopeCombo" Width="220" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Accent}" VerticalAlignment="Center">
          <TextBlock Text="Aa" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Bulk Rename" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
        <TextBlock x:Name="DocText" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="12,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- ===== Top: what to rename · preview ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="180" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <!-- What to rename -->
      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
            <TextBlock Text="What to rename" Style="{StaticResource PanelTitle}" />
            <TextBlock Text="Tick one or more kinds." Style="{StaticResource Hint}" Margin="0,2,0,0" />
          </StackPanel>
          <ListBox x:Name="TargetsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" Padding="6,0,6,8"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" Margin="8,12,0,4" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding Tip}">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource TextDim}" FontSize="11.5" VerticalAlignment="Center" />
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Label}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Preview -->
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="14,12,14,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox x:Name="ChangesOnly" Content="Only names that change" Margin="0,0,14,0" />
              <Button x:Name="SelectAllButton" Content="Include all" Style="{StaticResource Quiet}" />
              <Button x:Name="SelectNoneButton" Content="Include none" Style="{StaticResource Quiet}" />
            </StackPanel>
            <Grid Width="280" HorizontalAlignment="Left">
              <TextBox x:Name="SearchBox" Padding="28,0,6,0" ToolTip="Show only names containing this text" />
              <Path Data="M5,0 A5,5 0 1 1 4.99,0 M8.5,8.5 L12,12" Stroke="{DynamicResource TextDim}" StrokeThickness="1.4"
                    Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
              <TextBlock x:Name="SearchHint" Text="Search names" Foreground="{DynamicResource TextDim}" Margin="29,0,0,0"
                         VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
          </DockPanel>
          <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended" IsReadOnly="False" RowHeight="28"
                    Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource PanelAlt}"
                    Foreground="{DynamicResource Text}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}"
                    EnableRowVirtualization="True" Margin="1,0,1,6">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                      <Border Background="{TemplateBinding Background}" Padding="8,0">
                        <ContentPresenter VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Selection}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                              ToolTip="Include in the rename" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="CURRENT NAME" Binding="{Binding Current, Mode=OneWay}" IsReadOnly="True" Width="2*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="NEW NAME" Width="2*" SortMemberPath="New">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding New}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Text}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Changes}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="KIND" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Width="Auto">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /></Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="DETAILS" Binding="{Binding Detail, Mode=OneWay}" IsReadOnly="True" Width="1.2*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="STATUS" Width="1.2*" SortMemberPath="Status">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Message}">
                      <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" Fill="{DynamicResource TextDim}" Opacity="0.6" />
                      <TextBlock x:Name="Txt" Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDim}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Tone}" Value="Good">
                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Good}" /><Setter TargetName="Dot" Property="Opacity" Value="1" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Good}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tone}" Value="Bad">
                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Bad}" /><Setter TargetName="Dot" Property="Opacity" Value="1" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Bad}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tone}" Value="Warn">
                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Warn}" /><Setter TargetName="Dot" Property="Opacity" Value="1" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Warn}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===== Rules: every panel visible (like Bulk Rename Utility), numbered in the order they run ===== -->
    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,10,0,0" Padding="10,8,2,2">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,0,8,8">
          <Button x:Name="TokenButton" DockPanel.Dock="Right" Content="{}{ } Insert Revit value" Style="{StaticResource Quiet}"
                  ToolTip="Put a Revit value such as {Level}, {Sheet Number} or any parameter into the text box you were typing in. Each item gets its own value." />
          <TextBlock Text="Rules" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
          <TextBlock Text="Tick a panel to use it (typing in one ticks it). They run in number order; the preview updates as you type."
                     Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,1,0,0" />
        </DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid x:Name="RulesPanel" MinWidth="1120">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="RegexOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Regex.Enabled}" ToolTip="Use the RegEx panel" />
            <TextBlock Text="RegEx" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(1)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=RegexOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Match" Style="{StaticResource Label}" />
            <TextBox Grid.Column="1" Style="{StaticResource Code}" Text="{Binding Regex.Match, UpdateSourceTrigger=PropertyChanged}" ToolTip="A regular expression, e.g. ^Level (\d+)" />
            <TextBlock Grid.Row="1" Text="Replace" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource Code}" Text="{Binding Regex.Replace, UpdateSourceTrigger=PropertyChanged}" ToolTip="$1, $2… for the groups in brackets" />
            <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Content="Match case" IsChecked="{Binding Regex.MatchCase}" />
          </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="NameOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Name.Enabled}" ToolTip="Use the Name panel" />
            <TextBlock Text="Name" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(2)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=NameOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource Label}" />
            <ComboBox x:Name="NameModeCombo" Grid.Column="1" SelectedValue="{Binding Name.Mode}" />
            <TextBlock Grid.Row="1" Text="Text" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Name.Fixed, UpdateSourceTrigger=PropertyChanged}" ToolTip="For Fixed text: the new name. Revit values such as {Level} or {Sheet Number} work (Insert Revit value)." />
          </Grid>
          </StackPanel>
        </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="ReplaceOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Replace.Enabled}" ToolTip="Use the Replace panel" />
            <TextBlock Text="Replace" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(3)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=ReplaceOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Replace" Style="{StaticResource Label}" />
            <TextBox Grid.Column="1" Text="{Binding Replace.Find, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text to find. Several at once: separate with |  (Lvl|Flr)" />
            <TextBlock Grid.Row="1" Text="With" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Replace.With, UpdateSourceTrigger=PropertyChanged}" ToolTip="One replacement for all, or one per find separated by |" />
            <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
              <CheckBox Content="Match case" IsChecked="{Binding Replace.MatchCase}" Margin="0,0,12,4" />
              <CheckBox Content="Whole word" IsChecked="{Binding Replace.WholeWord}" Margin="0,0,12,4" />
              <CheckBox Content="First" IsChecked="{Binding Replace.FirstOnly}" Margin="0,0,0,4" ToolTip="Only the first match" />
            </WrapPanel>
          </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="CaseOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Case.Enabled}" ToolTip="Use the Case panel" />
            <TextBlock Text="Case" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(4)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=CaseOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Case" Style="{StaticResource Label}" />
            <ComboBox x:Name="CaseModeCombo" Grid.Column="1" SelectedValue="{Binding Case.Mode}" />
            <TextBlock Grid.Row="1" Text="Except" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Case.Exceptions, UpdateSourceTrigger=PropertyChanged}" ToolTip="Words kept exactly as typed, e.g. HVAC, MEP, 3D" />
          </Grid>
          </StackPanel>
        </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="RemoveOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Remove.Enabled}" ToolTip="Use the Remove panel" />
            <TextBlock Text="Remove" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(5)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=RemoveOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="First n" Style="{StaticResource Label}" />
            <Grid Grid.Row="0" Grid.Column="1">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Remove.First, UpdateSourceTrigger=PropertyChanged}" ToolTip="Characters removed from the start" />
              <TextBlock Grid.Column="1" Text="Last n" Style="{StaticResource Label}" Margin="6,0,6,0" />
              <TextBox Grid.Column="2" Text="{Binding Remove.Last, UpdateSourceTrigger=PropertyChanged}" ToolTip="Characters removed from the end" />
            </Grid>
            <TextBlock Grid.Row="1" Text="From" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Remove.From, UpdateSourceTrigger=PropertyChanged}" ToolTip="Remove characters from this position (1 = first)" />
              <TextBlock Grid.Column="1" Text="to" Style="{StaticResource Label}" Margin="6,0,6,0" />
              <TextBox Grid.Column="2" Text="{Binding Remove.To, UpdateSourceTrigger=PropertyChanged}" ToolTip="…to this position (0 = to the end)" />
            </Grid>
            <TextBlock Grid.Row="2" Text="Chars" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Remove.Chars, UpdateSourceTrigger=PropertyChanged}" ToolTip="Every one of these characters is removed" />
            <TextBlock Grid.Row="3" Text="Words" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Remove.Words, UpdateSourceTrigger=PropertyChanged}" ToolTip="Whole words removed, e.g. Copy, of" />
            <TextBlock Grid.Row="4" Text="Crop" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="6" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <ComboBox x:Name="CropCombo" SelectedValue="{Binding Remove.Crop}" ToolTip="Remove everything before or after this text" />
              <TextBox Grid.Column="2" Text="{Binding Remove.CropText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0">
              <CheckBox Content="Digits" IsChecked="{Binding Remove.Digits}" Margin="0,0,12,4" />
              <CheckBox Content="Symbols" IsChecked="{Binding Remove.Symbols}" Margin="0,0,12,4" ToolTip="Anything not a letter, digit or space" />
              <CheckBox Content="Accents" IsChecked="{Binding Remove.Accents}" Margin="0,0,12,4" />
              <CheckBox Content="Trim" IsChecked="{Binding Remove.Trim}" Margin="0,0,12,4" ToolTip="Spaces at the start and end" />
              <CheckBox Content="Double spaces" IsChecked="{Binding Remove.DoubleSpaces}" Margin="0,0,0,4" />
            </WrapPanel>
          </Grid>
          </StackPanel>
        </Border>
            </StackPanel>
            <StackPanel Grid.Column="3">
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="AddOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Add.Enabled}" ToolTip="Use the Add panel" />
            <TextBlock Text="Add" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(6)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=AddOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Prefix" Style="{StaticResource Label}" />
            <TextBox Grid.Column="1" Text="{Binding Add.Prefix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text before the name; Revit values such as {Level} work" />
            <TextBlock Grid.Row="1" Text="Insert" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Add.Insert, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="1" Text="at pos." Style="{StaticResource Label}" Margin="6,0,6,0" />
              <TextBox Grid.Column="2" Text="{Binding Add.AtPosition, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 = before the first character; -1 = at the end" />
            </Grid>
            <TextBlock Grid.Row="2" Text="Suffix" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Add.Suffix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text after the name; Revit values such as {Sheet Number} work" />
            <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Content="Word space" IsChecked="{Binding Add.WordSpace}" ToolTip="Space between words: FloorPlan → Floor Plan" />
          </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="FilterOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Filter.Enabled}" ToolTip="Use the Filters panel: only names that match are renamed" />
            <TextBlock Text="Filters" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(8)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=FilterOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Mask" Style="{StaticResource Label}" />
            <TextBox Grid.Column="1" Text="{Binding Filter.Mask, UpdateSourceTrigger=PropertyChanged}" ToolTip="Only names matching this: * and ? wildcards; several separated by ;" />
            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
              <CheckBox Content="RegEx" IsChecked="{Binding Filter.UseRegex}" Margin="0,0,12,4" />
              <CheckBox Content="Match case" IsChecked="{Binding Filter.MatchCase}" Margin="0,0,12,4" />
              <CheckBox Content="Not matching" IsChecked="{Binding Filter.Invert}" Margin="0,0,0,4" />
            </WrapPanel>
          </Grid>
          </StackPanel>
        </Border>
            </StackPanel>
            <StackPanel Grid.Column="4">
        <Border Style="{StaticResource Rule}">
          <StackPanel>
          <DockPanel>
            <CheckBox x:Name="NumberOn" Tag="On" DockPanel.Dock="Right" IsChecked="{Binding Numbering.Enabled}" ToolTip="Use the Numbering panel" />
            <TextBlock Text="Numbering" Style="{StaticResource RuleTitle}" />
            <TextBlock Text="(7)" Style="{StaticResource RuleNumber}" />
          </DockPanel>
          <Grid Style="{StaticResource RuleBody}" Tag="{Binding IsChecked, ElementName=NumberOn}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Mode" Style="{StaticResource Label}" />
            <Grid Grid.Column="1">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="6" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
              <ComboBox x:Name="NumberModeCombo" SelectedValue="{Binding Numbering.Mode}" />
              <ComboBox x:Name="NumberStyleCombo" Grid.Column="2" SelectedValue="{Binding Numbering.Style}" ToolTip="Type: 1, 2, 3 or A, B, C" />
            </Grid>
            <TextBlock Grid.Row="1" Text="Start" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Numbering.Start, UpdateSourceTrigger=PropertyChanged}" ToolTip="First number" />
              <TextBlock Grid.Column="1" Text="Incr." Style="{StaticResource Label}" Margin="6,0,6,0" />
              <TextBox Grid.Column="2" Text="{Binding Numbering.Increment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Added each time" />
            </Grid>
            <TextBlock Grid.Row="2" Text="Pad" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Numbering.Pad, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum digits: 2 gives 01, 02…" />
              <TextBlock Grid.Column="1" Text="Sep." Style="{StaticResource Label}" Margin="6,0,6,0" />
              <TextBox Grid.Column="2" Text="{Binding Numbering.Separator, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text between the name and the number" />
            </Grid>
            <TextBlock Grid.Row="3" Text="at pos." Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Width="64" HorizontalAlignment="Left" Text="{Binding Numbering.AtPosition, UpdateSourceTrigger=PropertyChanged}" ToolTip="For Insert at: 1 = before the first character; -1 = at the end" />
            <TextBlock Grid.Row="4" Text="Restart" Style="{StaticResource Label}" Margin="0,6,0,0" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Numbering.RestartFor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Start again for each value, e.g. {Level}. Empty: one sequence. Numbers follow the list order (click a column to sort)." />
          </Grid>
          </StackPanel>
        </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===== Footer ===== -->
    <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,10,0,0" Padding="12,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource Quiet}" ToolTip="Untick every panel and clear them" Margin="0,0,8,0" />
          <Button x:Name="CloseButton" Content="Close" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
          <Button x:Name="RenameButton" Content="Rename" Style="{StaticResource AccentButton}" MinWidth="130" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Preset" Style="{StaticResource Label}" Margin="0,0,8,0" />
          <ComboBox x:Name="PresetCombo" Width="190" IsEditable="True" ToolTip="Type a name to save, or pick one to load" />
          <Button x:Name="LoadPresetButton" Content="Load" Style="{StaticResource Quiet}" Margin="4,0,0,0" />
          <Button x:Name="SavePresetButton" Content="Save" Style="{StaticResource Quiet}" />
          <Button x:Name="DeletePresetButton" Content="Delete" Style="{StaticResource Quiet}" />
          <Border Width="1" Background="{DynamicResource Line}" Margin="12,4,16,4" />
        </StackPanel>
        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
