<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus - Bulk Rename" Width="1480" Height="900" MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="12.5">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />

    <!-- ===== Inputs ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource InputBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrong}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Code" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="3,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MaxDropDownHeight" Value="360" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0"
                            Stroke="{DynamicResource TextDim}" StrokeThickness="1.4" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrong}" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="8,0,26,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
              <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" Margin="6,1,24,1" VerticalAlignment="Center"
                       Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                       IsReadOnly="{TemplateBinding IsReadOnly}" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6"
                        Padding="0,3" Margin="0,3,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="Shown" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Check box: a rounded box with a tick. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                      Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource LineStrong}">
                <Path x:Name="Tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="-1,-1,0,0" />
              </Border>
              <ContentPresenter x:Name="Text" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Text" Property="Margin" Value="0" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch for each step. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" BorderThickness="1"
                    Background="Transparent" BorderBrush="{DynamicResource TextDim}">
              <Ellipse x:Name="Knob" Width="10" Height="10" Fill="{DynamicResource TextDim}" HorizontalAlignment="Left" Margin="3,0,0,0" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Knob" Property="Fill" Value="White" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                <Setter TargetName="Knob" Property="Width" Value="12" />
                <Setter TargetName="Knob" Property="Height" Value="12" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="26" />
    </Style>

    <!-- Thin scroll bars -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bd" Background="{DynamicResource Scroll}" CornerRadius="4" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource TextDim}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
              <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="10" />
          <Setter Property="MinHeight" Value="10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                  <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Layout pieces ===== -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A step in the rules column: header row (switch, number, title, what it does), fields below when on. -->
    <Style x:Key="Step" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource StepBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="StepNumber" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Width" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StepWhat" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <!-- Fields: one label column (72) and one field column, the same in every step. -->
    <Style x:Key="Fields" TargetType="Grid">
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="16,14,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Rename items in" Style="{StaticResource Label}" Margin="0,0,10,0" />
        <ComboBox x:Name="ScopeCombo" Width="220" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Accent}" VerticalAlignment="Center">
          <TextBlock Text="Aa" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Bulk Rename" FontSize="19" FontWeight="SemiBold" />
          <TextBlock x:Name="DocText" Foreground="{DynamicResource TextDim}" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- ===== Body: what to rename · preview · rules ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="180" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="380" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- What to rename -->
      <Border Grid.Column="0" Style="{StaticResource Panel}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
            <TextBlock Text="What to rename" Style="{StaticResource PanelTitle}" />
            <TextBlock Text="Tick one or more kinds." Style="{StaticResource Hint}" Margin="0,2,0,0" />
          </StackPanel>
          <ListBox x:Name="TargetsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" Padding="6,0,6,8"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" Margin="8,12,0,4" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding Tip}">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource TextDim}" FontSize="11.5" VerticalAlignment="Center" />
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Label}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Preview -->
      <Border Grid.Column="2" Style="{StaticResource Panel}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="14,12,14,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox x:Name="ChangesOnly" Content="Only names that change" Margin="0,0,14,0" />
              <Button x:Name="SelectAllButton" Content="Include all" Style="{StaticResource Quiet}" />
              <Button x:Name="SelectNoneButton" Content="Include none" Style="{StaticResource Quiet}" />
            </StackPanel>
            <Grid Width="280" HorizontalAlignment="Left">
              <TextBox x:Name="SearchBox" Padding="28,0,6,0" ToolTip="Show only names containing this text" />
              <Path Data="M5,0 A5,5 0 1 1 4.99,0 M8.5,8.5 L12,12" Stroke="{DynamicResource TextDim}" StrokeThickness="1.4"
                    Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
              <TextBlock x:Name="SearchHint" Text="Search names" Foreground="{DynamicResource TextDim}" Margin="29,0,0,0"
                         VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
          </DockPanel>
          <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended" IsReadOnly="False" RowHeight="28"
                    Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource PanelAlt}"
                    Foreground="{DynamicResource Text}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}"
                    EnableRowVirtualization="True" Margin="1,0,1,6">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                      <Border Background="{TemplateBinding Background}" Padding="8,0">
                        <ContentPresenter VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Selection}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                              ToolTip="Include in the rename" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="CURRENT NAME" Binding="{Binding Current, Mode=OneWay}" IsReadOnly="True" Width="2*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="NEW NAME" Width="2*" SortMemberPath="New">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding New}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Text}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Changes}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="KIND" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Width="Auto">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /></Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="DETAILS" Binding="{Binding Detail, Mode=OneWay}" IsReadOnly="True" Width="1.2*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="STATUS" Width="1.2*" SortMemberPath="Status">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Message}">
                      <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" Fill="{DynamicResource TextDim}" Opacity="0.6" />
                      <TextBlock x:Name="Txt" Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDim}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Tone}" Value="Good">
                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Good}" /><Setter TargetName="Dot" Property="Opacity" Value="1" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Good}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tone}" Value="Bad">
                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Bad}" /><Setter TargetName="Dot" Property="Opacity" Value="1" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Bad}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tone}" Value="Warn">
                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Warn}" /><Setter TargetName="Dot" Property="Opacity" Value="1" />
                        <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Warn}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- Rules: the steps, top to bottom in the order they are applied -->
      <Border Grid.Column="4" Style="{StaticResource Panel}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8">
            <Button x:Name="TokenButton" DockPanel.Dock="Right" Content="{}{ } Insert Revit value" Style="{StaticResource Quiet}"
                    ToolTip="Put a Revit value such as {Level}, {Sheet Number} or any parameter into the text box you were typing in. Each item gets its own value." />
            <StackPanel>
              <TextBlock Text="Rules" Style="{StaticResource PanelTitle}" />
              <TextBlock Text="Turn steps on; they run top to bottom." Style="{StaticResource Hint}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,4">
            <StackPanel x:Name="RulesPanel">

              <!-- Filter: which names the steps apply to -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="FilterOn" Style="{StaticResource Switch}" IsChecked="{Binding Filter.Enabled}" />
                    <TextBlock Text="•" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="Only names matching" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="limit which names change" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=FilterOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Mask" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Text="{Binding Filter.Mask, UpdateSourceTrigger=PropertyChanged}" ToolTip="* and ? wildcards; several separated by ;" />
                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                      <CheckBox Content="RegEx" IsChecked="{Binding Filter.UseRegex}" Margin="0,0,16,0" />
                      <CheckBox Content="Match case" IsChecked="{Binding Filter.MatchCase}" Margin="0,0,16,0" />
                      <CheckBox Content="Not matching" IsChecked="{Binding Filter.Invert}" />
                    </WrapPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 1 Pattern (regular expression) -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="RegexOn" Style="{StaticResource Switch}" IsChecked="{Binding Regex.Enabled}" />
                    <TextBlock Text="1" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="Pattern" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="regular expression (advanced)" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=RegexOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Match" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Style="{StaticResource Code}" Text="{Binding Regex.Match, UpdateSourceTrigger=PropertyChanged}" ToolTip="A regular expression, e.g. ^Level (\d+)" />
                    <TextBlock Grid.Row="1" Text="Replace" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource Code}" Text="{Binding Regex.Replace, UpdateSourceTrigger=PropertyChanged}" ToolTip="$1, $2… for the groups in brackets" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Content="Match case" IsChecked="{Binding Regex.MatchCase}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 2 Name -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="NameOn" Style="{StaticResource Switch}" IsChecked="{Binding Name.Enabled}" />
                    <TextBlock Text="2" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="New name" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="start from scratch or a fixed text" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=NameOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <ComboBox x:Name="NameModeCombo" Grid.Column="1" SelectedValue="{Binding Name.Mode}" />
                    <TextBlock Grid.Row="1" Text="Text" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Name.Fixed, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="For Fixed text: the new name. Revit values such as {Level} or {Sheet Number} work (Insert Revit value)." />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 3 Replace -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="ReplaceOn" Style="{StaticResource Switch}" IsChecked="{Binding Replace.Enabled}" />
                    <TextBlock Text="3" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="Find &amp; replace" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="swap text in the name" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=ReplaceOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Find" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Text="{Binding Replace.Find, UpdateSourceTrigger=PropertyChanged}" ToolTip="Several at once: separate with |  (Lvl|Flr)" />
                    <TextBlock Grid.Row="1" Text="Replace with" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Replace.With, UpdateSourceTrigger=PropertyChanged}" ToolTip="One replacement for all, or one per find separated by |" />
                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                      <CheckBox Content="Match case" IsChecked="{Binding Replace.MatchCase}" Margin="0,0,16,0" />
                      <CheckBox Content="Whole word" IsChecked="{Binding Replace.WholeWord}" Margin="0,0,16,0" />
                      <CheckBox Content="First only" IsChecked="{Binding Replace.FirstOnly}" />
                    </WrapPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 4 Case -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="CaseOn" Style="{StaticResource Switch}" IsChecked="{Binding Case.Enabled}" />
                    <TextBlock Text="4" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="Case" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="UPPER, lower, Title" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=CaseOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Make" Style="{StaticResource Label}" />
                    <ComboBox x:Name="CaseModeCombo" Grid.Column="1" SelectedValue="{Binding Case.Mode}" />
                    <TextBlock Grid.Row="1" Text="Keep as is" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Case.Exceptions, UpdateSourceTrigger=PropertyChanged}" ToolTip="Words kept exactly as typed, e.g. HVAC, MEP, 3D" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 5 Remove -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="RemoveOn" Style="{StaticResource Switch}" IsChecked="{Binding Remove.Enabled}" />
                    <TextBlock Text="5" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="Remove" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="characters, words, spaces" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=RemoveOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="First / last" Style="{StaticResource Label}" />
                    <Grid Grid.Column="1">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Remove.First, UpdateSourceTrigger=PropertyChanged}" ToolTip="Characters removed from the start" />
                      <TextBox Grid.Column="2" Text="{Binding Remove.Last, UpdateSourceTrigger=PropertyChanged}" ToolTip="Characters removed from the end" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="From / to" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Remove.From, UpdateSourceTrigger=PropertyChanged}" ToolTip="Remove characters from this position (1 = first)" />
                      <TextBox Grid.Column="2" Text="{Binding Remove.To, UpdateSourceTrigger=PropertyChanged}" ToolTip="…to this position (0 = to the end)" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Characters" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Remove.Chars, UpdateSourceTrigger=PropertyChanged}" ToolTip="Every one of these characters is removed" />
                    <TextBlock Grid.Row="3" Text="Words" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Remove.Words, UpdateSourceTrigger=PropertyChanged}" ToolTip="Whole words removed, e.g. Copy, of" />
                    <TextBlock Grid.Row="4" Text="Crop" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <ComboBox x:Name="CropCombo" SelectedValue="{Binding Remove.Crop}" ToolTip="Remove everything before or after this text" />
                      <TextBox Grid.Column="2" Text="{Binding Remove.CropText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
                      <CheckBox Content="Digits" IsChecked="{Binding Remove.Digits}" Margin="0,0,16,6" />
                      <CheckBox Content="Symbols" IsChecked="{Binding Remove.Symbols}" Margin="0,0,16,6" ToolTip="Anything not a letter, digit or space" />
                      <CheckBox Content="Accents" IsChecked="{Binding Remove.Accents}" Margin="0,0,16,6" />
                      <CheckBox Content="Trim spaces" IsChecked="{Binding Remove.Trim}" Margin="0,0,16,6" ToolTip="Spaces at the start and end" />
                      <CheckBox Content="Double spaces" IsChecked="{Binding Remove.DoubleSpaces}" Margin="0,0,16,6" />
                    </WrapPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 6 Add -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="AddOn" Style="{StaticResource Switch}" IsChecked="{Binding Add.Enabled}" />
                    <TextBlock Text="6" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="Add" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="prefix, suffix, inserted text" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=AddOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Prefix" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Text="{Binding Add.Prefix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text before the name; Revit values such as {Level} work" />
                    <TextBlock Grid.Row="1" Text="Suffix" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Add.Suffix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text after the name; Revit values such as {Sheet Number} work" />
                    <TextBlock Grid.Row="2" Text="Insert" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Add.Insert, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Grid.Column="1" Text="at" Style="{StaticResource Label}" Margin="8,0,8,0" />
                      <TextBox Grid.Column="2" Text="{Binding Add.AtPosition, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 = before the first character; -1 = at the end" />
                    </Grid>
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Content="Space between words (FloorPlan → Floor Plan)" IsChecked="{Binding Add.WordSpace}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 7 Numbering -->
              <Border Style="{StaticResource Step}">
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="NumberOn" Style="{StaticResource Switch}" IsChecked="{Binding Numbering.Enabled}" />
                    <TextBlock Text="7" Style="{StaticResource StepNumber}" />
                    <TextBlock Text="Numbering" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="01, 02… in list order" Style="{StaticResource StepWhat}" />
                  </DockPanel>
                  <Grid Style="{StaticResource Fields}" Visibility="{Binding IsChecked, ElementName=NumberOn, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Where" Style="{StaticResource Label}" />
                    <Grid Grid.Column="1">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                      <ComboBox x:Name="NumberModeCombo" SelectedValue="{Binding Numbering.Mode}" />
                      <ComboBox x:Name="NumberStyleCombo" Grid.Column="2" SelectedValue="{Binding Numbering.Style}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Start / step" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Numbering.Start, UpdateSourceTrigger=PropertyChanged}" ToolTip="First number" />
                      <TextBox Grid.Column="2" Text="{Binding Numbering.Increment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Added each time" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Digits / sep." Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBox Text="{Binding Numbering.Pad, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum digits: 2 gives 01, 02…" />
                      <TextBox Grid.Column="2" Text="{Binding Numbering.Separator, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text between the name and the number" />
                    </Grid>
                    <TextBlock Grid.Row="3" Text="Insert at" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Width="80" HorizontalAlignment="Left"
                             Text="{Binding Numbering.AtPosition, UpdateSourceTrigger=PropertyChanged}" ToolTip="For Insert at: 1 = before the first character; -1 = at the end" />
                    <TextBlock Grid.Row="4" Text="Restart for" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Numbering.RestartFor, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Start again for each value, e.g. {Level}. Empty: one sequence. Numbers follow the list order (click a column to sort)." />
                  </Grid>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===== Footer ===== -->
    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="12,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource Quiet}" ToolTip="Turn every step off" Margin="0,0,8,0" />
          <Button x:Name="CloseButton" Content="Close" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
          <Button x:Name="RenameButton" Content="Rename" Style="{StaticResource Accent}" MinWidth="130" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Preset" Style="{StaticResource Label}" Margin="0,0,8,0" />
          <ComboBox x:Name="PresetCombo" Width="190" IsEditable="True" ToolTip="Type a name to save, or pick one to load" />
          <Button x:Name="LoadPresetButton" Content="Load" Style="{StaticResource Quiet}" Margin="4,0,0,0" />
          <Button x:Name="SavePresetButton" Content="Save" Style="{StaticResource Quiet}" />
          <Button x:Name="DeletePresetButton" Content="Delete" Style="{StaticResource Quiet}" />
          <Border Width="1" Background="{DynamicResource Line}" Margin="12,4,16,4" />
        </StackPanel>
        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
