<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI-free hub logic: agent discovery, pipe client, result flattening, export.
       Shared by the WPF hub, the CLI and (later) the MCP server. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nexus.Hub.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Contracts\Nexus.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Excel link: read/compare/write .xlsx/.xlsm templates (MIT). -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Workbook writes: cell-level edits that leave the rest of the file untouched (ClosedXML is used for reading only). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <!-- Print & PDF: combine sheet PDFs into one file (MIT). -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp brings System.Security.Cryptography.Pkcs 8.0.1, which has known vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): use a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
