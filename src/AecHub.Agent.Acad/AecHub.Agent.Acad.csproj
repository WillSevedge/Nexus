<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core AutoCAD-family agent. Loads in every AutoCAD-based product.
       Must NOT reference any vertical (Civil 3D, ...) API. -->
  <PropertyGroup>
    <TargetFramework>$(HostTargetFramework)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AecHub.Agent.Acad</RootNamespace>
    <AssemblyName>AecHub.Agent.Acad</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid Application/Color ambiguity with the AutoCAD API. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AecHub.Agent.Shared\AecHub.Agent.Shared.csproj" />
    <ProjectReference Include="..\AecHub.Contracts\AecHub.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="modules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="property-categories.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\..\build\AutoCad.targets" />

  <!-- Deploy the core agent + bundle manifest (Windows only). -->
  <Target Name="AecHubDeployAcadBundle" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(DeployToHost)' != 'false'">
    <ItemGroup>
      <_AecHubAcadFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AecHubAcadFiles)"
          DestinationFiles="@(_AecHubAcadFiles->'$(AcadBundleContentDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\deploy\autocad\PackageContents.xml" DestinationFolder="$(AcadBundleDir)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="AecHub: deployed AutoCAD $(HostYear) bundle to $(AcadBundleDir) (if copy warnings appeared above, close AutoCAD/Civil 3D and rebuild)" />
  </Target>

  <Target Name="AecHubCleanAcadBundle" AfterTargets="Clean" Condition="'$(OS)' == 'Windows_NT' and '$(DeployToHost)' != 'false'">
    <RemoveDir Directories="$(AcadBundleContentDir)" ContinueOnError="true" />
  </Target>
</Project>
