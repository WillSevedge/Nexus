  <AddIn Type="Application">
    <Name>AecHub Agent</Name>
    <Assembly>AecHub\AecHub.Agent.Revit.dll</Assembly>
    <FullClassName>AecHub.Agent.Revit.AgentApplication</FullClassName>
    <AddInId>6F3A1C2E-8B7D-4E59-9A41-2D5C7B9E0A13</AddInId>
    <VendorId>AECHUB</VendorId>
    <VendorDescription>AecHub: connects Revit to the AecHub hub application.</VendorDescription>
  </AddIn>
</RevitAddIns>
