<Window x:Class="MyRevitAddin.UI.ColumnManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Columns" Height="400" Width="600">
    <Grid>
        <StackPanel>
            <TextBlock Text="Select columns to display:" Margin="10"/>
            <ScrollViewer Height="300">
                <StackPanel Name="columnListPanel"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Name="BtnSelectAll" Content="Select All" Click="BtnSelectAll_Click" Width="100" Margin="5"/>
                <Button Name="BtnDeselectAll" Content="Deselect All" Click="BtnDeselectAll_Click" Width="100" Margin="5"/>
                <Button Name="BtnInverse" Content="Inverse Selection" Click="BtnInverse_Click" Width="120" Margin="5"/>
                <Button Name="BtnOK" Content="OK" Click="OK_Click" Width="80" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
