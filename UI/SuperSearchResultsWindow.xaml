<Window x:Class="MyRevitAddin.UI.SuperSearchResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Results" Height="500" Width="700">
    <Grid>
        <StackPanel>
            <TextBlock Text="Grouped Parameters:" Margin="10"/>
            <TreeView Name="treeViewParameters" Height="250"/>
            <DataGrid Name="dataGridResults" Height="150" AutoGenerateColumns="True"/>
            <Button Name="BtnManageColumns" Content="Manage Columns" Click="BtnManageColumns_Click" Width="150" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
