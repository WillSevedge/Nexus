<Window x:Class="MyRevitAddin.UI.SuperSearchSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Families" Height="400" Width="600">
    <Grid>
        <StackPanel>
            <TextBlock Text="Select families:" Margin="10"/>
            <ListBox Name="familyListBox" SelectionMode="Multiple" Height="250"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Name="BtnSelectAll" Content="Select All" Click="BtnSelectAll_Click" Width="100" Margin="5"/>
                <Button Name="BtnDeselectAll" Content="Deselect All" Click="BtnDeselectAll_Click" Width="100" Margin="5"/>
                <Button Name="BtnQuery" Content="Query" Click="BtnQuery_Click" Width="80" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
